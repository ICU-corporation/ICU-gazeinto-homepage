---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const {
  title = "GazeInto | Retinal Screening, Wherever You Are",
  description = "A self-operated XR fundus camera with AI screening for age-related eye diseases. 흐려진 글자 앞에서 멈추지 않도록.",
} = Astro.props;
---

<!doctype html>
<html lang="ko" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- Pretendard WebFont CDN (Universal Korean & Latin Typography) -->
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />

    <!-- Global Canonical & Multilingual Hreflang for Google -->
    <link rel="canonical" href="https://www.gazeinto.kr/" />
    <link rel="alternate" hreflang="ko" href="https://www.gazeinto.kr/" />
    <link rel="alternate" hreflang="en" href="https://www.gazeinto.kr/" />
    <link rel="alternate" hreflang="x-default" href="https://www.gazeinto.kr/" />

    <!-- SEO Primary Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="GazeInto, XR Fundus Camera, Presbyopia AI Diagnosis, Retinal Screening, Age-Related Macular Degeneration, Glaucoma, Diabetic Retinopathy, Ophthalmic AI, 게이즈인투, 노안 AI 진단, 안저 카메라" />
    <meta name="author" content="GazeInto Inc." />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Search Portal Verifications (Naver Search Advisor & Google Search Console) -->
    <meta name="naver-site-verification" content="" />
    <meta name="google-site-verification" content="" />

    <!-- Mobile Theme Color & PWA support -->
    <meta name="theme-color" content="#F8FAFC" />
    <meta name="msapplication-TileColor" content="#00A396" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.gazeinto.kr/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.gazeinto.kr/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:site_name" content="GazeInto Inc." />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="ko_KR" />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://www.gazeinto.kr/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://www.gazeinto.kr/og-image.png" />

    <!-- Google Search Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://www.gazeinto.kr/#organization",
          "name": "GazeInto Inc.",
          "url": "https://www.gazeinto.kr",
          "logo": "https://www.gazeinto.kr/og-image.png",
          "email": "gazeinto1nc@gmail.com",
          "sameAs": [
            "https://www.gazeinto.kr"
          ]
        },
        {
          "@type": "MedicalWebPage",
          "@id": "https://www.gazeinto.kr/#webpage",
          "url": "https://www.gazeinto.kr/",
          "name": title,
          "description": description,
          "inLanguage": ["en", "ko"],
          "about": [
            {
              "@type": "MedicalDevice",
              "name": "GazeInto XR Fundus Camera & AI Screening System",
              "recognizingAuthority": "IRB Certified Clinical Validation",
              "purpose": "Self-operated non-mydriatic XR fundus screening and quantitative presbyopia diagnostic refraction system"
            }
          ]
        }
      ]
    })} />
  </head>
  <body class="bg-[#F8FAFC] text-slate-900 font-sans antialiased selection:bg-[#00A396]/20 selection:text-[#00A396]">
    <slot />

    <!-- Global Scroll Observer for designxhand-like silky reveals -->
    <script>
      const scrollObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
          }
        });
      }, {
        threshold: 0.15,
        rootMargin: '0px 0px -50px 0px'
      });

      document.querySelectorAll('.scroll-reveal, .scroll-line').forEach(el => {
        scrollObserver.observe(el);
      });
    </script>
  </body>
</html>
