---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "GazeInto | Retinal Screening, Wherever You Are",
  description = "A self-operated XR fundus camera with AI screening for age-related eye diseases. 흐려진 글자 앞에서 멈추지 않도록.",
} = Astro.props;
---

<!doctype html>
<html lang="ko" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="게이즈인투, GazeInto, XR 안저 카메라, Fundus Camera, 노안 진단, 황반변성, 녹내장, 당뇨망막병증, AI 검안" />
    <meta name="author" content="GazeInto Inc." />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.gazeinto.kr/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.svg" />
    <meta property="og:site_name" content="GazeInto Inc." />
    <meta property="og:locale" content="ko_KR" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://www.gazeinto.kr/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/og-image.svg" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MedicalDevice",
      "name": "GazeInto XR Fundus Camera",
      "manufacturer": {
        "@type": "Organization",
        "name": "GazeInto Inc.",
        "url": "https://www.gazeinto.kr",
        "email": "gazeinto1nc@gmail.com"
      },
      "description": description
    })} />
  </head>
  <body class="bg-[#F8FAFC] text-slate-900 font-sans antialiased selection:bg-[#00A396]/20 selection:text-[#00A396]">
    <slot />

    <!-- Global Scroll Observer for designxhand-like silky reveals -->
    <script>
      const scrollObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
          }
        });
      }, {
        threshold: 0.15,
        rootMargin: '0px 0px -50px 0px'
      });

      document.querySelectorAll('.scroll-reveal, .scroll-line').forEach(el => {
        scrollObserver.observe(el);
      });
    </script>
  </body>
</html>
