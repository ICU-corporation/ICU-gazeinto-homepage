---
---

<section id="hero" class="relative min-h-[95vh] lg:min-h-screen pt-20 flex flex-col justify-between bg-[#0A1928] overflow-hidden select-none">
  
  <!-- Ambient High-Definition Video Background Layer -->
  <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none z-0">
    <video
      autoplay
      loop
      muted
      playsinline
      class="w-full h-full object-cover object-center opacity-90 scale-100"
    >
      <source src="/videos/hero-bg.mp4" type="video/mp4" />
    </video>
    
    <!-- Sophisticated Contrast Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#F8FAFC]/95 via-[#F8FAFC]/75 to-[#F8FAFC]/35"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#F8FAFC]/95 via-transparent to-[#F8FAFC]/25"></div>
  </div>

  <!-- Main Split Dashboard Container -->
  <div class="relative z-10 w-full max-w-[1920px] mx-auto px-6 sm:px-12 lg:px-16 flex-1 flex flex-col justify-center py-10 lg:py-16">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 xl:gap-16 items-center">
      
      <!-- Left Column: Main Typography & Brand Core (Vertically Centered in Middle) -->
      <div class="lg:col-span-5 xl:col-span-5 flex flex-col justify-center my-auto pt-2 lg:pt-0">
        
        <!-- Category Tag -->
        <div class="flex items-center gap-2 mb-6 scroll-reveal">
          <span class="w-5 h-[2px] bg-[#00A396] scroll-line"></span>
          <span class="font-mono text-xs font-bold tracking-[0.25em] text-[#00A396] uppercase drop-shadow-sm">
            노안 AI 진단 & 처방 엔진
          </span>
        </div>

        <!-- Headline (Blur to Sharp Typography with Interactive Hover Focus) -->
        <div class="mb-6 select-none">
          <h1 class="text-4xl sm:text-5xl xl:text-6xl font-black text-slate-900 tracking-tight leading-[1.15] mb-2 drop-shadow-sm">
            <!-- Line 1: Blurred text that clarifies on hover -->
            <span id="hero-blurred-text" class="blur-presbyopia inline-block cursor-default transition-all duration-700" title="초점이 흐려진 상태 (마우스를 올리면 선명해집니다)">
              흐려진 글자 앞에서
            </span>
            <br />
            <!-- Line 2: Sharp text -->
            <span class="text-slate-900 inline-block mt-2 scroll-reveal scroll-reveal-delay-1">
              멈추지 않도록.
            </span>
          </h1>
        </div>

        <!-- Description Paragraph -->
        <p class="text-base sm:text-lg text-slate-800 font-medium leading-relaxed max-w-xl mb-8 scroll-reveal scroll-reveal-delay-2 drop-shadow-sm">
          게이즈인투의 AI는 노안의 진행 단계를 정량 판독하고, 당신의 눈이 실제로 머무는 거리에 맞춰 처방을 설계합니다.
        </p>

        <!-- Quick CTA Buttons -->
        <div class="flex flex-wrap items-center gap-4 scroll-reveal scroll-reveal-delay-3">
          <button
            type="button"
            onclick="window.openContactModal('trial')"
            class="px-7 py-3.5 rounded-xl bg-[#0F2236] hover:bg-[#1A334E] text-white text-sm font-bold tracking-tight shadow-md transition-all duration-200 hover:-translate-y-0.5 flex items-center gap-2"
          >
            <span>30초 자가 진단 시작</span>
            <svg class="w-4 h-4 text-[#00C4B4]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>

          <button
            type="button"
            onclick="window.openContactModal('b2b')"
            class="px-7 py-3.5 rounded-xl bg-white/85 hover:bg-white text-slate-800 text-sm font-semibold tracking-tight border border-slate-300/80 shadow-sm backdrop-blur-sm transition-all duration-200 hover:-translate-y-0.5"
          >
            안경원·의원 도입 문의
          </button>
        </div>

      </div>

      <!-- Right Column: 4-Card Visible Cascading Fan Deck (4개 카드 모두 겹쳐 보이는 부채꼴 덱) -->
      <div class="lg:col-span-7 xl:col-span-7 w-full flex flex-col items-center justify-center relative">

        <!-- Fanned Deck Viewport with Room for 4 Cascading Cards -->
        <div class="w-full max-w-xl relative h-[600px] flex items-end justify-center overflow-visible pb-4" id="card-deck-viewport">
          
          <!-- ========================================================= -->
          <!-- STACK CARD 0: 01 대시보드 (Live Prescribed Optic) -->
          <!-- ========================================================= -->
          <div
            id="stack-card-0"
            onclick="window.goToStackCard(0)"
            class="fan-card absolute inset-x-0 bottom-4 h-[460px] rounded-[2rem] bg-white border border-slate-200/90 p-6 sm:p-7 flex flex-col justify-between cursor-pointer transition-all duration-500 ease-[cubic-bezier(0.2,0.8,0.2,1)] origin-right hover:brightness-[1.02]"
            style="transform: translateY(0px) translateX(0px) rotate(0deg) scale(1); z-index: 40; box-shadow: 0 30px 60px -15px rgba(8,23,38,0.24);"
          >
            <!-- Card Header (Always Visible on Fanned Tabs) -->
            <div class="card-header flex items-center justify-between pb-3 border-b border-slate-100">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#00A396] shadow-[0_0_8px_#00A396]"></span>
                <span class="font-mono text-xs sm:text-sm font-extrabold tracking-wider text-slate-900 uppercase">
                  01 / LIVE PRESCRIBED OPTIC
                </span>
              </div>
              <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-[#00A396]/10 text-[#00A396] font-bold border border-[#00A396]/20">
                AUTO CALIBRATE
              </span>
            </div>

            <!-- Card Body (Only active card displays full body to keep 100% clean legibility) -->
            <div class="card-body space-y-4 transition-opacity duration-300">
              <div class="space-y-2">
                <div class="flex items-center justify-between text-xs">
                  <span class="text-slate-600 font-medium">작업 거리별 처방 가입도</span>
                  <span class="font-mono font-bold text-[#00A396]">실시간 보정값</span>
                </div>

                <div class="grid grid-cols-5 gap-1.5" id="hero-dist-buttons">
                  <button type="button" data-dist="25" data-add="+2.25" class="dist-btn p-2 rounded-xl border border-slate-200 bg-slate-50 hover:bg-white text-center transition-all">
                    <div class="font-mono text-[10px] text-slate-400">25cm</div>
                    <div class="font-mono text-xs font-bold text-slate-700">+2.25</div>
                  </button>
                  <button type="button" data-dist="33" data-add="+1.75" class="dist-btn p-2 rounded-xl border-2 border-[#00A396] bg-[#00A396]/10 text-center transition-all shadow-sm">
                    <div class="font-mono text-[10px] text-[#00A396] font-bold">33cm ★</div>
                    <div class="font-mono text-xs font-black text-[#00A396]">+1.75</div>
                  </button>
                  <button type="button" data-dist="45" data-add="+1.25" class="dist-btn p-2 rounded-xl border border-slate-200 bg-slate-50 hover:bg-white text-center transition-all">
                    <div class="font-mono text-[10px] text-slate-400">45cm</div>
                    <div class="font-mono text-xs font-bold text-slate-700">+1.25</div>
                  </button>
                  <button type="button" data-dist="60" data-add="+0.75" class="dist-btn p-2 rounded-xl border border-slate-200 bg-slate-50 hover:bg-white text-center transition-all">
                    <div class="font-mono text-[10px] text-slate-400">60cm</div>
                    <div class="font-mono text-xs font-bold text-slate-700">+0.75</div>
                  </button>
                  <button type="button" data-dist="80" data-add="+0.50" class="dist-btn p-2 rounded-xl border border-slate-200 bg-slate-50 hover:bg-white text-center transition-all">
                    <div class="font-mono text-[10px] text-slate-400">80cm</div>
                    <div class="font-mono text-xs font-bold text-slate-700">+0.50</div>
                  </button>
                </div>

                <!-- Output Display -->
                <div class="p-4 rounded-2xl bg-[#081726] text-white flex items-center justify-between shadow-sm">
                  <div>
                    <span class="font-mono text-[10px] text-[#22D3EE] uppercase tracking-wider font-bold block mb-0.5">
                      RECOMMENDED ADD
                    </span>
                    <span class="text-xs text-slate-300">근거리 주시 환경 기반 처방값</span>
                  </div>
                  <div class="flex items-baseline gap-1">
                    <span id="hero-live-add-val" class="text-3xl font-black font-mono text-white tracking-tight">
                      +1.75
                    </span>
                    <span class="text-xs text-[#00C4B4] font-mono font-bold">D</span>
                  </div>
                </div>
              </div>

              <!-- Biomarker Badges -->
              <div class="grid grid-cols-3 gap-2 text-center text-xs">
                <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200">
                  <div class="text-slate-500 font-medium text-[11px]">황반 (AMD)</div>
                  <div class="font-bold text-[#00A396] font-mono">정상 (&lt;1%)</div>
                </div>
                <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200">
                  <div class="text-slate-500 font-medium text-[11px]">시신경 (녹내장)</div>
                  <div class="font-bold text-[#00A396] font-mono">C/D 0.32 안정</div>
                </div>
                <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200">
                  <div class="text-slate-500 font-medium text-[11px]">망막혈관 (DR)</div>
                  <div class="font-bold text-slate-800 font-mono">Clear</div>
                </div>
              </div>
            </div>

            <!-- Card Bottom Bar with Flip Trigger & Controls -->
            <div class="card-footer pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600 transition-opacity duration-300">
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs text-slate-400 font-semibold">01 / 04</span>
                <span class="text-slate-300">·</span>
                <span class="text-[11px] text-slate-400">카드를 누르면 넘겨집니다</span>
              </div>
              
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  onclick="event.stopPropagation(); window.prevStackCard();"
                  class="w-7 h-7 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center transition-all"
                  title="이전 카드"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
                  </svg>
                </button>
                <button
                  type="button"
                  onclick="event.stopPropagation(); window.nextStackCard();"
                  class="px-3 py-1.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white font-bold flex items-center gap-1.5 transition-all"
                >
                  <span>02 기술 보기</span>
                  <svg class="w-3.5 h-3.5 text-[#00C4B4]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- ========================================================= -->
          <!-- STACK CARD 1: 02 기술 (3-Step All-In-One XR Flow) -->
          <!-- ========================================================= -->
          <div
            id="stack-card-1"
            onclick="window.goToStackCard(1)"
            class="fan-card absolute inset-x-0 bottom-4 h-[460px] rounded-[2rem] bg-[#FAFCFE] border border-slate-300/90 p-6 sm:p-7 flex flex-col justify-between cursor-pointer transition-all duration-500 ease-[cubic-bezier(0.2,0.8,0.2,1)] origin-right hover:brightness-[1.02]"
            style="transform: translateY(-44px) translateX(-20px) rotate(6deg) scale(0.96); z-index: 30; opacity: 0.96; box-shadow: 0 20px 40px -10px rgba(8,23,38,0.16);"
          >
            <!-- Card Header -->
            <div class="card-header flex items-center justify-between pb-3 border-b border-slate-100">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#00A396]"></span>
                <span class="font-mono text-xs sm:text-sm font-extrabold tracking-wider text-slate-900 uppercase">
                  02 / ALL-IN-ONE XR WORKFLOW
                </span>
              </div>
              <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-[#00A396]/10 text-[#00A396] font-bold border border-[#00A396]/20">
                3-STEP PROCESS
              </span>
            </div>

            <!-- Steps List -->
            <div class="card-body space-y-2.5 transition-opacity duration-300">
              <div class="p-3 rounded-xl bg-white border border-slate-200 flex items-start gap-3 shadow-xs">
                <span class="font-mono font-black text-[#00A396] text-sm shrink-0">01</span>
                <div>
                  <h4 class="text-xs font-bold text-slate-900">자가 착용 (Self-operated Wear)</h4>
                  <p class="text-xs text-slate-500 leading-snug mt-0.5">병원 방문 없이 집이나 일상 공간에서 가볍게 착용 후 즉시 시작</p>
                </div>
              </div>

              <div class="p-3 rounded-xl bg-white border border-slate-200 flex items-start gap-3 shadow-xs">
                <span class="font-mono font-black text-[#00A396] text-sm shrink-0">02</span>
                <div>
                  <h4 class="text-xs font-bold text-slate-900">시선 유도 자동 촬영 (Gaze Guidance)</h4>
                  <p class="text-xs text-slate-500 leading-snug mt-0.5">동공 정렬 인터랙션으로 고해상도 망막 안저 이미지 자동 캡처</p>
                </div>
              </div>

              <div class="p-3 rounded-xl bg-white border border-slate-200 flex items-start gap-3 shadow-xs">
                <span class="font-mono font-black text-[#00A396] text-sm shrink-0">03</span>
                <div>
                  <h4 class="text-xs font-bold text-slate-900">3대 실명 질환 AI 분석 (AI Screening)</h4>
                  <p class="text-xs text-slate-500 leading-snug mt-0.5">황반변성(AMD), 녹내장, 당뇨망막병증 초기 징후를 온디바이스 판독</p>
                </div>
              </div>

              <!-- Feature Highlight Pill -->
              <div class="p-3.5 rounded-xl bg-[#081726] text-white flex items-center justify-between text-xs">
                <span class="text-[#22D3EE] font-mono font-bold">검사 시간 단 30초</span>
                <span class="text-slate-300">정밀 일치율 98.4%</span>
              </div>
            </div>

            <!-- Card Bottom Bar with Flip Trigger & Controls -->
            <div class="card-footer pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600 transition-opacity duration-300">
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs text-slate-400 font-semibold">02 / 04</span>
                <span class="text-slate-300">·</span>
                <span class="text-[11px] text-slate-400">카드를 누르면 넘겨집니다</span>
              </div>

              <div class="flex items-center gap-2">
                <button
                  type="button"
                  onclick="event.stopPropagation(); window.prevStackCard();"
                  class="w-7 h-7 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center transition-all"
                  title="이전 카드"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
                  </svg>
                </button>
                <button
                  type="button"
                  onclick="event.stopPropagation(); window.nextStackCard();"
                  class="px-3 py-1.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white font-bold flex items-center gap-1.5 transition-all"
                >
                  <span>03 임상 근거 보기</span>
                  <svg class="w-3.5 h-3.5 text-[#00C4B4]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- ========================================================= -->
          <!-- STACK CARD 2: 03 임상 근거 (Clinical Matrix) -->
          <!-- ========================================================= -->
          <div
            id="stack-card-2"
            onclick="window.goToStackCard(2)"
            class="fan-card absolute inset-x-0 bottom-4 h-[460px] rounded-[2rem] bg-[#FAFCFE] border border-slate-300/90 p-6 sm:p-7 flex flex-col justify-between cursor-pointer transition-all duration-500 ease-[cubic-bezier(0.2,0.8,0.2,1)] origin-right hover:brightness-[1.02]"
            style="transform: translateY(-86px) translateX(-38px) rotate(12deg) scale(0.92); z-index: 20; opacity: 0.92; box-shadow: 0 15px 30px -10px rgba(8,23,38,0.14);"
          >
            <!-- Card Header -->
            <div class="card-header flex items-center justify-between pb-3 border-b border-slate-100">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#00A396]"></span>
                <span class="font-mono text-xs sm:text-sm font-extrabold tracking-wider text-slate-900 uppercase">
                  03 / CLINICAL COMPARISON MATRIX
                </span>
              </div>
              <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-[#00A396]/10 text-[#00A396] font-bold border border-[#00A396]/20">
                CLINICAL VALIDATED
              </span>
            </div>

            <!-- Comparison Table -->
            <div class="card-body space-y-4 transition-opacity duration-300">
              <div class="rounded-2xl border border-slate-200 overflow-hidden text-xs bg-white">
                <table class="w-full text-center">
                  <thead class="bg-slate-100 font-mono text-[10px] text-slate-600 uppercase border-b border-slate-200">
                    <tr>
                      <th class="py-2.5 px-3 text-left">장비 유형</th>
                      <th class="py-2.5 px-1">검사자 불필요</th>
                      <th class="py-2.5 px-1">재택/비대면</th>
                      <th class="py-2.5 px-1">온디바이스 AI</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    <tr class="text-slate-500 bg-white">
                      <td class="py-2.5 px-3 text-left font-medium">거치형 안저기</td>
                      <td class="py-2.5 px-1 text-slate-300">—</td>
                      <td class="py-2.5 px-1 text-slate-300">—</td>
                      <td class="py-2.5 px-1 text-slate-300">—</td>
                    </tr>
                    <tr class="text-slate-500 bg-white">
                      <td class="py-2.5 px-3 text-left font-medium">핸드헬드 카메라</td>
                      <td class="py-2.5 px-1 text-slate-300">—</td>
                      <td class="py-2.5 px-1 text-slate-300">—</td>
                      <td class="py-2.5 px-1 text-slate-300">—</td>
                    </tr>
                    <tr class="bg-slate-900 text-white font-bold">
                      <td class="py-2.5 px-3 text-left text-[#00C4B4]">GazeInto XR</td>
                      <td class="py-2.5 px-1 text-[#00C4B4] text-sm">✓</td>
                      <td class="py-2.5 px-1 text-[#00C4B4] text-sm">✓</td>
                      <td class="py-2.5 px-1 text-[#00C4B4] text-sm">✓</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <!-- Targeted 3 Diseases -->
              <div class="grid grid-cols-3 gap-2 text-center text-xs">
                <div class="p-2.5 rounded-xl bg-white border border-slate-200">
                  <div class="font-bold text-slate-900 text-xs">황반변성</div>
                  <div class="text-[10px] text-slate-500 mt-0.5">드루젠 조기포착</div>
                </div>
                <div class="p-2.5 rounded-xl bg-white border border-slate-200">
                  <div class="font-bold text-slate-900 text-xs">녹내장</div>
                  <div class="text-[10px] text-slate-500 mt-0.5">C/D비 정밀계측</div>
                </div>
                <div class="p-2.5 rounded-xl bg-white border border-slate-200">
                  <div class="font-bold text-slate-900 text-xs">당뇨망막병증</div>
                  <div class="text-[10px] text-slate-500 mt-0.5">미세출혈 감지</div>
                </div>
              </div>
            </div>

            <!-- Card Bottom Bar with Flip Trigger & Controls -->
            <div class="card-footer pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600 transition-opacity duration-300">
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs text-slate-400 font-semibold">03 / 04</span>
                <span class="text-slate-300">·</span>
                <span class="text-[11px] text-slate-400">카드를 누르면 넘겨집니다</span>
              </div>

              <div class="flex items-center gap-2">
                <button
                  type="button"
                  onclick="event.stopPropagation(); window.prevStackCard();"
                  class="w-7 h-7 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center transition-all"
                  title="이전 카드"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
                  </svg>
                </button>
                <button
                  type="button"
                  onclick="event.stopPropagation(); window.nextStackCard();"
                  class="px-3 py-1.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white font-bold flex items-center gap-1.5 transition-all"
                >
                  <span>04 FAQ 보기</span>
                  <svg class="w-3.5 h-3.5 text-[#00C4B4]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- ========================================================= -->
          <!-- STACK CARD 3: 04 FAQ (Frequently Asked Questions) -->
          <!-- ========================================================= -->
          <div
            id="stack-card-3"
            onclick="window.goToStackCard(3)"
            class="fan-card absolute inset-x-0 bottom-4 h-[460px] rounded-[2rem] bg-[#FAFCFE] border border-slate-300/90 p-6 sm:p-7 flex flex-col justify-between cursor-pointer transition-all duration-500 ease-[cubic-bezier(0.2,0.8,0.2,1)] origin-right hover:brightness-[1.02]"
            style="transform: translateY(-126px) translateX(-54px) rotate(17deg) scale(0.88); z-index: 10; opacity: 0.88; box-shadow: 0 15px 30px -10px rgba(8,23,38,0.14);"
          >
            <!-- Card Header -->
            <div class="card-header flex items-center justify-between pb-3 border-b border-slate-100">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#00A396]"></span>
                <span class="font-mono text-xs sm:text-sm font-extrabold tracking-wider text-slate-900 uppercase">
                  04 / FREQUENTLY ASKED QUESTIONS
                </span>
              </div>
              <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-[#00A396]/10 text-[#00A396] font-bold border border-[#00A396]/20">
                FAQ & SUPPORT
              </span>
            </div>

            <!-- Compact Accordion List -->
            <div class="card-body space-y-2 overflow-y-auto max-h-[280px] pr-1 transition-opacity duration-300">
              <div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
                <button type="button" class="dash-faq-toggle w-full p-3 text-left flex items-center justify-between text-xs font-bold text-slate-900 hover:text-[#00A396] transition-colors">
                  <span>Q1. 비숙련자나 어르신도 혼자 촬영할 수 있나요?</span>
                  <span class="text-slate-400 font-mono text-sm">+</span>
                </button>
                <div class="dash-faq-answer hidden px-3 pb-3 text-xs text-slate-600 leading-relaxed border-t border-slate-200/60 pt-2">
                  지능형 시선 유도(Gaze Guidance)가 동공 위치를 자동 가이드하여 누구나 혼자서 30초 내에 촬영합니다.
                </div>
              </div>

              <div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
                <button type="button" class="dash-faq-toggle w-full p-3 text-left flex items-center justify-between text-xs font-bold text-slate-900 hover:text-[#00A396] transition-colors">
                  <span>Q2. 재택 환경 및 이동 검진에서도 가능한가요?</span>
                  <span class="text-slate-400 font-mono text-sm">+</span>
                </button>
                <div class="dash-faq-answer hidden px-3 pb-3 text-xs text-slate-600 leading-relaxed border-t border-slate-200/60 pt-2">
                  거대 암실 장비가 필요 없는 컴팩트 일체형 헤드셋으로 가정 및 보건지소 등에서도 편리하게 운용됩니다.
                </div>
              </div>

              <div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
                <button type="button" class="dash-faq-toggle w-full p-3 text-left flex items-center justify-between text-xs font-bold text-slate-900 hover:text-[#00A396] transition-colors">
                  <span>Q3. 안경원·의원 도입 상담은 어떻게 하나요?</span>
                  <span class="text-slate-400 font-mono text-sm">+</span>
                </button>
                <div class="dash-faq-answer hidden px-3 pb-3 text-xs text-slate-600 leading-relaxed border-t border-slate-200/60 pt-2">
                  상단의 '도입 문의' 또는 공식 이메일(gazeinto1nc@gmail.com)로 접수해주시면 전담팀이 방문 데모를 진행합니다.
                </div>
              </div>
            </div>

            <!-- Card Bottom Bar with Flip Trigger & Controls -->
            <div class="card-footer pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600 transition-opacity duration-300">
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs text-slate-400 font-semibold">04 / 04</span>
                <span class="text-slate-300">·</span>
                <span class="text-[11px] text-slate-400">카드를 누르면 넘겨집니다</span>
              </div>

              <div class="flex items-center gap-2">
                <button
                  type="button"
                  onclick="event.stopPropagation(); window.prevStackCard();"
                  class="w-7 h-7 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center transition-all"
                  title="이전 카드"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
                  </svg>
                </button>
                <button
                  type="button"
                  onclick="event.stopPropagation(); window.goToStackCard(0);"
                  class="px-3 py-1.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white font-bold flex items-center gap-1.5 transition-all"
                >
                  <span>01 대시보드로 돌아가기</span>
                  <svg class="w-3.5 h-3.5 text-[#00C4B4]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>

</section>

<script>
  // ==============================================================
  // Pure High-Legibility Fanned-Out 3D Card Deck Animation & Controller (4-Card Visible Cascade)
  // ==============================================================
  let currentCardIndex = 0;
  const totalCards = 4;
  const cards = [
    document.getElementById('stack-card-0'),
    document.getElementById('stack-card-1'),
    document.getElementById('stack-card-2'),
    document.getElementById('stack-card-3')
  ];

  const headerLinks = document.querySelectorAll('.nav-link');
  const navIdList = ['nav-hero', 'nav-tech', 'nav-clinical', 'nav-faq'];

  // All 4 Cards Visibly Stepped & Cascading in Fan-out Sequence
  const fanConfigs = [
    // diff 0 (Active Front Focus): 100% Solid White, Full Opacity, Sharp Shadow
    { translateY: 0, translateX: 0, rotate: 0, scale: 1, zIndex: 40, opacity: 1, shadow: '0 30px 60px -15px rgba(8,23,38,0.24)' },
    // diff 1 (1st card fan-step): Tilted up-left, clean header tab peek
    { translateY: -44, translateX: -20, rotate: 6, scale: 0.96, zIndex: 30, opacity: 0.96, shadow: '0 20px 40px -10px rgba(8,23,38,0.16)' },
    // diff 2 (2nd card fan-step): Mid upper angle peek
    { translateY: -86, translateX: -38, rotate: 12, scale: 0.92, zIndex: 20, opacity: 0.92, shadow: '0 15px 30px -10px rgba(8,23,38,0.14)' },
    // diff 3 (3rd card fan-step): Top upper angle peek (100% visible on top)
    { translateY: -126, translateX: -54, rotate: 17, scale: 0.88, zIndex: 10, opacity: 0.88, shadow: '0 15px 30px -10px rgba(8,23,38,0.14)' }
  ];

  function updateFanLayout() {
    cards.forEach((card, i) => {
      if (!card) return;
      const diff = (i - currentCardIndex + totalCards) % totalCards;
      const config = fanConfigs[diff];

      card.style.transform = `translateY(${config.translateY}px) translateX(${config.translateX}px) rotate(${config.rotate}deg) scale(${config.scale})`;
      card.style.zIndex = `${config.zIndex}`;
      card.style.opacity = `${config.opacity}`;
      card.style.boxShadow = config.shadow;

      // Cleanliness Guard: Only show body and footer on ACTIVE card, so background cards only show clean header tabs without visual clutter
      const body = card.querySelector('.card-body') as HTMLElement;
      const footer = card.querySelector('.card-footer') as HTMLElement;

      if (diff === 0) {
        card.classList.remove('bg-[#FAFCFE]');
        card.classList.add('bg-white');
        if (body) {
          body.style.opacity = '1';
          body.style.pointerEvents = 'auto';
        }
        if (footer) {
          footer.style.opacity = '1';
          footer.style.pointerEvents = 'auto';
        }
      } else {
        card.classList.remove('bg-white');
        card.classList.add('bg-[#FAFCFE]');
        if (body) {
          body.style.opacity = '0';
          body.style.pointerEvents = 'none';
        }
        if (footer) {
          footer.style.opacity = '0';
          footer.style.pointerEvents = 'none';
        }
      }
    });

    // Update Header Navigation Capsule
    headerLinks.forEach((link) => {
      const targetNavId = navIdList[currentCardIndex];
      const navDot = link.querySelector('.nav-dot');
      if (link.id === targetNavId) {
        link.className = 'nav-link px-3 sm:px-3.5 py-1.5 rounded-full transition-all duration-300 flex items-center gap-1.5 bg-white text-slate-950 font-bold shadow-sm border border-slate-200/80';
        if (navDot) navDot.classList.remove('hidden');
      } else {
        link.className = 'nav-link px-3 sm:px-3.5 py-1.5 rounded-full transition-all duration-300 flex items-center gap-1.5 hover:text-slate-900 text-slate-600';
        if (navDot) navDot.classList.add('hidden');
      }
    });
  }

  function goToStackCard(index: number) {
    if (index >= 0 && index < totalCards) {
      currentCardIndex = index;
      updateFanLayout();
    }
  }

  function nextStackCard() {
    currentCardIndex = (currentCardIndex + 1) % totalCards;
    updateFanLayout();
  }

  function prevStackCard() {
    currentCardIndex = (currentCardIndex - 1 + totalCards) % totalCards;
    updateFanLayout();
  }

  // Expose to window for global buttons
  (window as any).goToStackCard = goToStackCard;
  (window as any).nextStackCard = nextStackCard;
  (window as any).prevStackCard = prevStackCard;
  (window as any).switchDashboardTab = (tabKey: string) => {
    const map: Record<string, number> = {
      'tab-dashboard': 0,
      'hero': 0,
      'tab-tech': 1,
      'technology': 1,
      'tab-clinical': 2,
      'clinical': 2,
      'tab-faq': 3,
      'faq': 3
    };
    if (map[tabKey] !== undefined) {
      goToStackCard(map[tabKey]);
    }
  };

  // Keyboard Arrow Key Navigation Support
  window.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') nextStackCard();
    if (e.key === 'ArrowLeft') prevStackCard();
  });

  // Reading Distance Gauge Interactive Switcher in Card 0
  const distBtns = document.querySelectorAll('#hero-dist-buttons .dist-btn');
  const addValDisplay = document.getElementById('hero-live-add-val');

  distBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      distBtns.forEach(b => {
        b.className = 'dist-btn p-2 rounded-xl border border-slate-200 bg-slate-50 hover:bg-white text-center transition-all';
        const num = b.querySelector('.font-bold, .font-black') as HTMLElement;
        const sub = b.querySelector('.text-[10px]') as HTMLElement;
        if (num) num.className = 'font-mono text-xs font-bold text-slate-700';
        if (sub) sub.className = 'font-mono text-[10px] text-slate-400';
      });

      btn.className = 'dist-btn p-2 rounded-xl border-2 border-[#00A396] bg-[#00A396]/10 text-center transition-all shadow-sm';
      const activeNum = btn.querySelector('.font-bold, .font-black') as HTMLElement;
      const activeSub = btn.querySelector('.text-[10px]') as HTMLElement;
      if (activeNum) activeNum.className = 'font-mono text-xs font-black text-[#00A396]';
      if (activeSub) activeSub.className = 'font-mono text-[10px] text-[#00A396] font-bold';

      const addVal = btn.getAttribute('data-add');
      if (addValDisplay && addVal) {
        addValDisplay.textContent = addVal;
      }
    });
  });

  // Mini FAQ Accordion inside Card 3
  const faqToggles = document.querySelectorAll('.dash-faq-toggle');
  faqToggles.forEach(toggle => {
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const ans = toggle.nextElementSibling as HTMLElement;
      const isHidden = ans.classList.contains('hidden');
      document.querySelectorAll('.dash-faq-answer').forEach(a => a.classList.add('hidden'));
      if (isHidden) {
        ans.classList.remove('hidden');
      }
    });
  });

  // Initialize Fan Layout
  updateFanLayout();
</script>
