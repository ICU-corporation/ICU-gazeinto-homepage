---
---

<section id="hero" class="relative min-h-[96vh] lg:min-h-screen pt-20 pb-6 flex flex-col justify-between bg-[#0A1928] overflow-hidden select-none">
  
  <!-- Ambient High-Definition Video Background Layer -->
  <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none z-0">
    <video
      autoplay
      loop
      muted
      playsinline
      class="w-full h-full object-cover object-center opacity-95 scale-100"
    >
      <source src="/videos/hero-bg.mp4" type="video/mp4" />
    </video>
    
    <!-- Sophisticated Contrast Gradient Overlay (Preserving VR character in center/right) -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#F8FAFC]/95 via-[#F8FAFC]/45 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#F8FAFC]/70 via-transparent to-transparent"></div>
  </div>

  <!-- Main Container: Top Left Typography + Bottom 4-Column Horizontal Cards -->
  <div class="relative z-10 w-full max-w-[1920px] mx-auto px-6 sm:px-10 lg:px-14 flex-1 flex flex-col justify-between pt-14 sm:pt-20 lg:pt-24 pb-4">
    
    <!-- Top-Left Content Section: Main Typography & Copy (Moved Downward) -->
    <div class="max-w-xl lg:max-w-2xl pt-6 sm:pt-12 lg:pt-16 xl:pt-20">
      
      <!-- Category Tag -->
      <div class="flex items-center gap-2 mb-3 scroll-reveal">
        <span class="w-5 h-[2px] bg-[#00A396] scroll-line"></span>
        <span class="font-mono text-xs font-bold tracking-[0.25em] text-[#00A396] uppercase drop-shadow-sm">
          노안 AI 진단 & 처방 엔진
        </span>
      </div>

      <!-- Headline (Blur to Sharp Typography with Interactive Hover Focus) -->
      <div class="mb-3 select-none">
        <h1 class="text-3xl sm:text-5xl xl:text-6xl font-black text-slate-900 tracking-tight leading-[1.12] mb-2 drop-shadow-sm">
          <!-- Line 1: Blurred text that clarifies on hover -->
          <span id="hero-blurred-text" class="blur-presbyopia inline-block cursor-default transition-all duration-700" title="초점이 흐려진 상태 (마우스를 올리면 선명해집니다)">
            흐려진 글자 앞에서
          </span>
          <br />
          <!-- Line 2: Sharp text -->
          <span class="text-slate-900 inline-block mt-1 scroll-reveal scroll-reveal-delay-1">
            멈추지 않도록.
          </span>
        </h1>
      </div>

      <!-- Description Paragraph -->
      <div class="max-w-xl mb-4">
        <p class="text-sm sm:text-base xl:text-lg text-slate-800 font-medium leading-relaxed scroll-reveal scroll-reveal-delay-2 drop-shadow-sm">
          게이즈인투의 AI는 노안의 진행 단계를 정량 판독하고, 당신의 눈이 실제로 머무는 거리에 맞춰 처방을 설계합니다.
        </p>
      </div>

    </div>

    <!-- Bottom Section: 4 Horizontal Side-by-Side Cards (하단 4개 가로 배치 카드) -->
    <div class="w-full mt-auto pt-6">
      
      <!-- 4-Column Grid along the bottom -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3.5 xl:gap-4 w-full" id="hero-card-grid">
        
        <!-- ========================================================= -->
        <!-- CARD 0: 01 대시보드 (Live Prescribed Optic) -->
        <!-- ========================================================= -->
        <div
          id="hero-card-0"
          onclick="window.selectHeroCard(0)"
          class="hero-bottom-card rounded-3xl p-4 sm:p-5 flex flex-col justify-between cursor-pointer transition-all duration-300 bg-white/95 backdrop-blur-xl border-2 border-[#00A396]/60 shadow-xl ring-2 ring-[#00A396]/20 h-[260px] sm:h-[250px]"
        >
          <!-- Card Header -->
          <div class="flex items-center justify-between pb-2 border-b border-slate-200/70">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-[#00A396] shadow-[0_0_8px_#00A396]"></span>
              <span class="font-mono text-xs font-extrabold tracking-wider text-slate-900 uppercase">
                01 / LIVE PRESCRIBED OPTIC
              </span>
            </div>
            <span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-[#00A396]/15 text-[#00A396] font-bold border border-[#00A396]/30">
              AUTO CALIBRATE
            </span>
          </div>

          <!-- Card Body: Distance buttons + Output -->
          <div class="space-y-2 my-auto">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-slate-600 font-semibold">거리별 처방 가입도</span>
              <span class="font-mono font-bold text-[#00A396]">실시간 AI</span>
            </div>

            <!-- Distance Buttons -->
            <div class="grid grid-cols-5 gap-1" id="hero-dist-buttons">
              <button type="button" data-dist="25" data-add="+2.25" class="dist-btn p-1 rounded-lg border border-slate-200 bg-slate-50 hover:bg-white text-center transition-all">
                <div class="font-mono text-[9px] text-slate-400">25cm</div>
                <div class="font-mono text-[11px] font-bold text-slate-700">+2.25</div>
              </button>
              <button type="button" data-dist="33" data-add="+1.75" class="dist-btn p-1 rounded-lg border-2 border-[#00A396] bg-[#00A396]/10 text-center transition-all shadow-xs">
                <div class="font-mono text-[9px] text-[#00A396] font-bold">33cm★</div>
                <div class="font-mono text-[11px] font-black text-[#00A396]">+1.75</div>
              </button>
              <button type="button" data-dist="45" data-add="+1.25" class="dist-btn p-1 rounded-lg border border-slate-200 bg-slate-50 hover:bg-white text-center transition-all">
                <div class="font-mono text-[9px] text-slate-400">45cm</div>
                <div class="font-mono text-[11px] font-bold text-slate-700">+1.25</div>
              </button>
              <button type="button" data-dist="60" data-add="+0.75" class="dist-btn p-1 rounded-lg border border-slate-200 bg-slate-50 hover:bg-white text-center transition-all">
                <div class="font-mono text-[9px] text-slate-400">60cm</div>
                <div class="font-mono text-[11px] font-bold text-slate-700">+0.75</div>
              </button>
              <button type="button" data-dist="80" data-add="+0.50" class="dist-btn p-1 rounded-lg border border-slate-200 bg-slate-50 hover:bg-white text-center transition-all">
                <div class="font-mono text-[9px] text-slate-400">80cm</div>
                <div class="font-mono text-[11px] font-bold text-slate-700">+0.50</div>
              </button>
            </div>

            <!-- Output Display -->
            <div class="p-2 rounded-xl bg-[#081726] text-white flex items-center justify-between shadow-xs">
              <div>
                <span class="font-mono text-[8px] text-[#22D3EE] uppercase tracking-wider font-bold block">RECOMMENDED ADD</span>
                <span class="text-[10px] text-slate-300">작업 거리 맞춤 처방</span>
              </div>
              <div class="flex items-baseline gap-1">
                <span id="hero-live-add-val" class="text-xl sm:text-2xl font-black font-mono text-white tracking-tight">+1.75</span>
                <span class="text-[10px] text-[#00C4B4] font-mono font-bold">D</span>
              </div>
            </div>
          </div>

          <!-- Card Footer -->
          <div class="pt-1.5 border-t border-slate-200/70 flex items-center justify-between text-[11px] text-slate-600">
            <span class="font-mono text-slate-400 font-semibold">01 / 04</span>
            <span class="text-[#00A396] font-mono font-bold flex items-center gap-1">
              <span>ACTIVE COCKPIT</span>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </div>
        </div>

        <!-- ========================================================= -->
        <!-- CARD 1: 02 기술 (All-In-One XR Workflow) -->
        <!-- ========================================================= -->
        <div
          id="hero-card-1"
          onclick="window.selectHeroCard(1)"
          class="hero-bottom-card rounded-3xl p-4 sm:p-5 flex flex-col justify-between cursor-pointer transition-all duration-300 bg-white/40 hover:bg-white/70 backdrop-blur-md border border-white/60 shadow-sm h-[260px] sm:h-[250px]"
        >
          <!-- Card Header -->
          <div class="flex items-center justify-between pb-2 border-b border-slate-200/60">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-[#00A396]"></span>
              <span class="font-mono text-xs font-extrabold tracking-wider text-slate-900 uppercase">
                02 / XR WORKFLOW
              </span>
            </div>
            <span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-[#00A396]/15 text-[#00A396] font-bold border border-[#00A396]/30">
              3-STEP PROCESS
            </span>
          </div>

          <!-- Card Body: 3 Step Rows -->
          <div class="space-y-1.5 my-auto text-xs">
            <div class="p-1.5 rounded-xl bg-white/80 border border-slate-200/70 flex items-center gap-2 shadow-2xs">
              <span class="font-mono font-black text-[#00A396] text-[10px] px-1.5 py-0.5 rounded bg-[#00A396]/10">01</span>
              <div>
                <div class="font-bold text-slate-900 text-[11px]">자가 착용 (Wear)</div>
                <div class="text-[9px] text-slate-500">가정/일상에서 즉시 착용</div>
              </div>
            </div>
            <div class="p-1.5 rounded-xl bg-white/80 border border-slate-200/70 flex items-center gap-2 shadow-2xs">
              <span class="font-mono font-black text-[#00A396] text-[10px] px-1.5 py-0.5 rounded bg-[#00A396]/10">02</span>
              <div>
                <div class="font-bold text-slate-900 text-[11px]">시선 유도 자동 촬영</div>
                <div class="text-[9px] text-slate-500">동공 자동 정렬 안저 캡처</div>
              </div>
            </div>
            <div class="p-1.5 rounded-xl bg-white/80 border border-slate-200/70 flex items-center gap-2 shadow-2xs">
              <span class="font-mono font-black text-[#00A396] text-[10px] px-1.5 py-0.5 rounded bg-[#00A396]/10">03</span>
              <div>
                <div class="font-bold text-slate-900 text-[11px]">3대 질환 AI 분석</div>
                <div class="text-[9px] text-slate-500">온디바이스 30초 판독</div>
              </div>
            </div>
          </div>

          <!-- Card Footer -->
          <div class="pt-1.5 border-t border-slate-200/60 flex items-center justify-between text-[11px] text-slate-600">
            <span class="font-mono text-slate-400 font-semibold">02 / 04</span>
            <span class="text-slate-700 font-mono font-bold flex items-center gap-1">
              <span>VIEW TECH</span>
              <svg class="w-3 h-3 text-[#00A396]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </div>
        </div>

        <!-- ========================================================= -->
        <!-- CARD 2: 03 임상 근거 (Clinical Matrix) -->
        <!-- ========================================================= -->
        <div
          id="hero-card-2"
          onclick="window.selectHeroCard(2)"
          class="hero-bottom-card rounded-3xl p-4 sm:p-5 flex flex-col justify-between cursor-pointer transition-all duration-300 bg-white/40 hover:bg-white/70 backdrop-blur-md border border-white/60 shadow-sm h-[260px] sm:h-[250px]"
        >
          <!-- Card Header -->
          <div class="flex items-center justify-between pb-2 border-b border-slate-200/60">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-[#00A396]"></span>
              <span class="font-mono text-xs font-extrabold tracking-wider text-slate-900 uppercase">
                03 / CLINICAL MATRIX
              </span>
            </div>
            <span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-[#00A396]/15 text-[#00A396] font-bold border border-[#00A396]/30">
              CLINICAL VALIDATED
            </span>
          </div>

          <!-- Card Body: 3 Biomarkers + Stats -->
          <div class="space-y-2 my-auto text-xs">
            <div class="grid grid-cols-3 gap-1 text-center">
              <div class="p-1.5 rounded-xl bg-white/80 border border-slate-200/70">
                <div class="text-slate-500 font-medium text-[9px]">황반(AMD)</div>
                <div class="font-bold text-[#00A396] font-mono text-[10px]">정상 &lt;1%</div>
              </div>
              <div class="p-1.5 rounded-xl bg-white/80 border border-slate-200/70">
                <div class="text-slate-500 font-medium text-[9px]">시신경</div>
                <div class="font-bold text-[#00A396] font-mono text-[10px]">C/D 0.32</div>
              </div>
              <div class="p-1.5 rounded-xl bg-white/80 border border-slate-200/70">
                <div class="text-slate-500 font-medium text-[9px]">망막혈관</div>
                <div class="font-bold text-slate-800 font-mono text-[10px]">Clear</div>
              </div>
            </div>

            <div class="p-2 rounded-xl bg-slate-900 text-white flex items-center justify-between text-[11px] shadow-2xs">
              <div class="text-center"><div class="font-mono font-black text-[#00C4B4]">98.4%</div><div class="text-[8px] text-slate-400">일치율</div></div>
              <span class="text-slate-600">|</span>
              <div class="text-center"><div class="font-mono font-black text-white">4개</div><div class="text-[8px] text-slate-400">협력안과</div></div>
              <span class="text-slate-600">|</span>
              <div class="text-center"><div class="font-mono font-black text-white">12만</div><div class="text-[8px] text-slate-400">데이터</div></div>
            </div>
          </div>

          <!-- Card Footer -->
          <div class="pt-1.5 border-t border-slate-200/60 flex items-center justify-between text-[11px] text-slate-600">
            <span class="font-mono text-slate-400 font-semibold">03 / 04</span>
            <span class="text-slate-700 font-mono font-bold flex items-center gap-1">
              <span>VIEW CLINICAL</span>
              <svg class="w-3 h-3 text-[#00A396]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </div>
        </div>

        <!-- ========================================================= -->
        <!-- CARD 3: 04 FAQ & SUPPORT (Frequently Asked Questions) -->
        <!-- ========================================================= -->
        <div
          id="hero-card-3"
          onclick="window.selectHeroCard(3)"
          class="hero-bottom-card rounded-3xl p-4 sm:p-5 flex flex-col justify-between cursor-pointer transition-all duration-300 bg-white/40 hover:bg-white/70 backdrop-blur-md border border-white/60 shadow-sm h-[260px] sm:h-[250px]"
        >
          <!-- Card Header -->
          <div class="flex items-center justify-between pb-2 border-b border-slate-200/60">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-[#00A396]"></span>
              <span class="font-mono text-xs font-extrabold tracking-wider text-slate-900 uppercase">
                04 / FAQ & SUPPORT
              </span>
            </div>
            <span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-[#00A396]/15 text-[#00A396] font-bold border border-[#00A396]/30">
              FAQ & SUPPORT
            </span>
          </div>

          <!-- Card Body: 2 Quick Q&As -->
          <div class="space-y-1.5 my-auto text-xs">
            <div class="p-2 rounded-xl bg-white/80 border border-slate-200/70 shadow-2xs">
              <span class="font-bold text-slate-900 text-[11px] block">Q. 혼자서 촬영 가능한가요?</span>
              <p class="text-[10px] text-slate-600 leading-tight mt-0.5">지능형 시선 유도로 비숙련자도 30초 내 자동 촬영</p>
            </div>
            <div class="p-2 rounded-xl bg-white/80 border border-slate-200/70 shadow-2xs">
              <span class="font-bold text-slate-900 text-[11px] block">Q. 안경원 및 의원 도입 문의</span>
              <p class="text-[10px] text-slate-600 leading-tight mt-0.5">전담팀이 현장 실증 및 소프트웨어 데모를 지원합니다</p>
            </div>
          </div>

          <!-- Card Footer -->
          <div class="pt-1.5 border-t border-slate-200/60 flex items-center justify-between text-[11px] text-slate-600">
            <span class="font-mono text-slate-400 font-semibold">04 / 04</span>
            <span class="text-slate-700 font-mono font-bold flex items-center gap-1">
              <span>VIEW FAQ</span>
              <svg class="w-3 h-3 text-[#00A396]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </div>
        </div>

      </div>

    </div>

  </div>

</section>

<script>
  // ==============================================================
  // 4-Column Horizontal Bottom Cards Interactive Controller
  // ==============================================================
  let activeCardIndex = 0;
  const cardElements = [
    document.getElementById('hero-card-0'),
    document.getElementById('hero-card-1'),
    document.getElementById('hero-card-2'),
    document.getElementById('hero-card-3')
  ];

  const headerLinks = document.querySelectorAll('.nav-link');
  const navIdList = ['nav-hero', 'nav-tech', 'nav-clinical', 'nav-faq'];

  function selectHeroCard(index: number) {
    if (index < 0 || index >= cardElements.length) return;
    activeCardIndex = index;

    cardElements.forEach((card, i) => {
      if (!card) return;
      if (i === activeCardIndex) {
        // Active Solid Card
        card.className = 'hero-bottom-card rounded-3xl p-4 sm:p-5 flex flex-col justify-between cursor-pointer transition-all duration-300 bg-white/95 backdrop-blur-xl border-2 border-[#00A396]/60 shadow-xl ring-2 ring-[#00A396]/20 h-[260px] sm:h-[250px] scale-[1.02] z-20';
      } else {
        // Translucent Frosted Glass Inactive Card
        card.className = 'hero-bottom-card rounded-3xl p-4 sm:p-5 flex flex-col justify-between cursor-pointer transition-all duration-300 bg-white/40 hover:bg-white/70 backdrop-blur-md border border-white/60 shadow-sm h-[260px] sm:h-[250px] scale-100 opacity-90 hover:opacity-100 z-10';
      }
    });

    // Update Header Navigation Capsule
    headerLinks.forEach((link) => {
      const targetNavId = navIdList[activeCardIndex];
      const navDot = link.querySelector('.nav-dot');
      if (link.id === targetNavId) {
        link.className = 'nav-link px-3 sm:px-3.5 py-1.5 rounded-full transition-all duration-300 flex items-center gap-1.5 bg-white text-slate-950 font-bold shadow-sm border border-slate-200/80';
        if (navDot) navDot.classList.remove('hidden');
      } else {
        link.className = 'nav-link px-3 sm:px-3.5 py-1.5 rounded-full transition-all duration-300 flex items-center gap-1.5 hover:text-slate-900 text-slate-600';
        if (navDot) navDot.classList.add('hidden');
      }
    });
  }

  // Expose to window for global header navigation
  (window as any).selectHeroCard = selectHeroCard;
  (window as any).goToStackCard = selectHeroCard;
  (window as any).switchDashboardTab = (tabKey: string) => {
    const map: Record<string, number> = {
      'tab-dashboard': 0,
      'hero': 0,
      'tab-tech': 1,
      'technology': 1,
      'tab-clinical': 2,
      'clinical': 2,
      'tab-faq': 3,
      'faq': 3
    };
    if (map[tabKey] !== undefined) {
      selectHeroCard(map[tabKey]);
    }
  };

  // Reading Distance Gauge Interactive Switcher in Card 0
  const distBtns = document.querySelectorAll('#hero-dist-buttons .dist-btn');
  const addValDisplay = document.getElementById('hero-live-add-val');

  distBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      distBtns.forEach(b => {
        b.className = 'dist-btn p-1 rounded-lg border border-slate-200 bg-slate-50 hover:bg-white text-center transition-all';
        const num = b.querySelector('.font-bold, .font-black') as HTMLElement;
        const sub = b.querySelector('.text-[9px]') as HTMLElement;
        if (num) num.className = 'font-mono text-[11px] font-bold text-slate-700';
        if (sub) sub.className = 'font-mono text-[9px] text-slate-400';
      });

      btn.className = 'dist-btn p-1 rounded-lg border-2 border-[#00A396] bg-[#00A396]/10 text-center transition-all shadow-xs';
      const activeNum = btn.querySelector('.font-bold, .font-black') as HTMLElement;
      const activeSub = btn.querySelector('.text-[9px]') as HTMLElement;
      if (activeNum) activeNum.className = 'font-mono text-[11px] font-black text-[#00A396]';
      if (activeSub) activeSub.className = 'font-mono text-[9px] text-[#00A396] font-bold';

      const addVal = btn.getAttribute('data-add');
      if (addValDisplay && addVal) {
        addValDisplay.textContent = addVal;
      }
    });
  });

  // Blur-to-Sharp Typography Interaction
  const blurredText = document.getElementById('hero-blurred-text');
  if (blurredText) {
    blurredText.addEventListener('mouseenter', () => {
      blurredText.classList.remove('blur-presbyopia');
      blurredText.classList.add('blur-none');
    });
    blurredText.addEventListener('mouseleave', () => {
      blurredText.classList.remove('blur-none');
      blurredText.classList.add('blur-presbyopia');
    });
  }

  // Initialize Card Selection
  selectHeroCard(0);
</script>

<style>
  /* Presbyopia blur simulation effect */
  .blur-presbyopia {
    filter: blur(4px);
    opacity: 0.85;
  }
  .blur-presbyopia:hover, .blur-none {
    filter: blur(0px);
    opacity: 1;
  }
</style>
