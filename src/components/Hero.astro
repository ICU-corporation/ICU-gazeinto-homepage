---
---

<section id="hero" class="relative min-h-screen pt-20 flex flex-col justify-between bg-[#F8FAFC] overflow-hidden">
  
  <!-- Main Split Layout Container -->
  <div class="w-full flex-1 flex flex-col lg:flex-row items-stretch">
    
    <!-- Left Section: 72% Width Clean Light Content -->
    <div class="flex-1 lg:w-[72%] px-6 sm:px-12 lg:px-20 xl:px-24 pt-16 sm:pt-24 lg:pt-28 pb-16 flex flex-col justify-between">
      
      <!-- Top Content Block -->
      <div class="max-w-3xl">
        
        <!-- Category Tag -->
        <div class="flex items-center gap-2 mb-8 scroll-reveal">
          <span class="w-5 h-[2px] bg-[#00A396] scroll-line"></span>
          <span class="font-mono text-xs font-bold tracking-[0.25em] text-[#00A396] uppercase">
            노안 AI 진단 & 처방 엔진
          </span>
        </div>

        <!-- Headline (Hero B: Blur to Sharp Typography with Scroll/Hover Interactive Focus) -->
        <div class="mb-8 select-none">
          <h1 class="text-4xl sm:text-6xl xl:text-7xl font-black text-slate-900 tracking-tight leading-[1.1] mb-2">
            <!-- Line 1: Blurred text that clarifies on scroll or hover -->
            <span id="hero-blurred-text" class="blur-presbyopia inline-block cursor-default transition-all duration-700" title="초점이 흐려진 상태 (스크롤하거나 마우스를 올리면 선명해집니다)">
              흐려진 글자 앞에서
            </span>
            <br />
            <!-- Line 2: Sharp text -->
            <span class="text-slate-900 inline-block mt-2 scroll-reveal scroll-reveal-delay-1">
              멈추지 않도록.
            </span>
          </h1>
        </div>

        <!-- Description Paragraph -->
        <p class="text-base sm:text-lg text-slate-600 font-normal leading-relaxed max-w-xl mb-8 scroll-reveal scroll-reveal-delay-2">
          게이즈인투의 AI는 노안의 진행 단계를 정량 판독하고, 당신의 눈이 실제로 머무는 거리에 맞춰 처방을 설계합니다.
        </p>


        <!-- CTA Buttons (Hidden for now, preserved for future feature additions) -->
        <div class="hidden flex-wrap items-center gap-4 mb-16 scroll-reveal scroll-reveal-delay-3" id="hero-cta-buttons">
          <button
            type="button"
            onclick="window.openContactModal('trial')"
            class="px-8 py-4 rounded bg-[#0F2236] hover:bg-[#1A334E] text-white text-sm font-bold tracking-tight shadow-sm transition-all duration-200 hover:-translate-y-0.5"
          >
            30초 자가 진단 시작
          </button>

          <button
            type="button"
            onclick="window.openContactModal('b2b')"
            class="px-8 py-4 rounded bg-white hover:bg-slate-50 text-slate-800 text-sm font-semibold tracking-tight border border-slate-300 shadow-sm transition-all duration-200 hover:-translate-y-0.5"
          >
            안경원·의원 도입 문의
          </button>
        </div>

      </div>

      <!-- Bottom Stats & Validation Bar -->
      <div class="pt-8 border-t border-slate-200/80 mt-auto scroll-reveal">
        <div class="flex flex-wrap items-center gap-8 sm:gap-14 text-xs sm:text-sm">
          <span class="font-mono text-[11px] sm:text-xs font-medium tracking-widest text-slate-400 uppercase">
            CLINICALLY VALIDATED
          </span>

          <div class="flex items-baseline gap-1.5">
            <strong class="font-extrabold text-slate-900 text-base sm:text-lg font-mono">98.4%</strong>
            <span class="text-slate-500 font-medium">판독 일치율</span>
          </div>

          <div class="flex items-baseline gap-1.5">
            <strong class="font-extrabold text-slate-900 text-base sm:text-lg font-mono">4개</strong>
            <span class="text-slate-500 font-medium">협력 안과</span>
          </div>

          <div class="flex items-baseline gap-1.5">
            <strong class="font-extrabold text-slate-900 text-base sm:text-lg font-mono">12만</strong>
            <span class="text-slate-500 font-medium">학습 데이터</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Right Section: 28% Width Deep Navy Split Panel -->
    <div id="right-panel" class="lg:w-[28%] bg-[#081726] px-8 sm:px-12 py-16 sm:py-24 flex flex-col justify-between border-t lg:border-t-0 lg:border-l border-slate-900/30 relative select-none overflow-hidden">
      
      <!-- Ambient Background Radial Glow -->
      <div class="absolute -top-24 -right-24 w-72 h-72 bg-[#00A396]/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-[#22D3EE]/10 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Top Section: Reading Distance Gauge -->
      <div class="relative z-10">
        <div class="flex items-center justify-between mb-8">
          <div class="font-mono text-xs font-bold tracking-[0.2em] text-[#22D3EE] uppercase flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-[#22D3EE] animate-ping"></span>
            READING DISTANCE (cm)
          </div>
          <span class="font-mono text-[10px] text-[#00A396] tracking-wider px-2 py-0.5 rounded bg-[#00A396]/10 border border-[#00A396]/20">
            AUTO SCAN
          </span>
        </div>

        <!-- Stepped Distance Gauge Lines with Laser Wave Sequence -->
        <div class="space-y-6 relative" id="gauge-container">
          
          <!-- Moving Scanning Laser Indicator Beam -->
          <div id="gauge-scan-beam" class="absolute -left-3 w-1.5 h-5 bg-gradient-to-b from-transparent via-[#22D3EE] to-transparent rounded-full shadow-[0_0_10px_#22D3EE] transition-all duration-500 pointer-events-none" style="top: 36px;"></div>

          <!-- 25cm -->
          <div class="distance-gauge-item flex items-center gap-4 group cursor-pointer transition-all duration-300" data-dist="25" data-add="+2.25" data-index="0">
            <div class="gauge-line w-10 h-[2px] bg-[#22D3EE] group-hover:w-14 transition-all duration-300 opacity-60"></div>
            <span class="gauge-num font-mono text-xs font-semibold text-slate-400 group-hover:text-[#22D3EE] transition-colors">25</span>
          </div>

          <!-- 33cm (Recommended Baseline) -->
          <div class="distance-gauge-item flex items-center gap-4 group cursor-pointer is-active transition-all duration-300" data-dist="33" data-add="+1.75" data-index="1">
            <div class="gauge-line w-16 h-[2px] bg-[#22D3EE] group-hover:w-20 transition-all duration-300 shadow-[0_0_12px_rgba(34,211,238,0.9)]"></div>
            <div class="flex items-center gap-2">
              <span class="gauge-num font-mono text-xs font-bold text-[#22D3EE]">33</span>
              <span class="w-1.5 h-1.5 rounded-full bg-[#22D3EE] animate-pulse"></span>
            </div>
          </div>

          <!-- 45cm -->
          <div class="distance-gauge-item flex items-center gap-4 group cursor-pointer transition-all duration-300" data-dist="45" data-add="+1.25" data-index="2">
            <div class="gauge-line w-28 h-[2px] bg-[#00A396] group-hover:w-32 transition-all duration-300 opacity-60"></div>
            <span class="gauge-num font-mono text-xs font-semibold text-slate-400 group-hover:text-[#00A396] transition-colors">45</span>
          </div>

          <!-- 60cm -->
          <div class="distance-gauge-item flex items-center gap-4 group cursor-pointer transition-all duration-300" data-dist="60" data-add="+0.75" data-index="3">
            <div class="gauge-line w-40 h-[2px] bg-[#1E3A52] group-hover:w-44 transition-all duration-300"></div>
            <span class="gauge-num font-mono text-xs font-medium text-slate-500 group-hover:text-slate-300 transition-colors">60</span>
          </div>

          <!-- 80cm -->
          <div class="distance-gauge-item flex items-center gap-4 group cursor-pointer transition-all duration-300" data-dist="80" data-add="+0.50" data-index="4">
            <div class="gauge-line w-52 h-[1px] bg-[#1E293B] group-hover:w-56 transition-all duration-300"></div>
            <span class="gauge-num font-mono text-xs font-normal text-slate-600 group-hover:text-slate-400 transition-colors">80</span>
          </div>
        </div>
      </div>

      <!-- Middle Interactive Fundus Retina AI Scanner Viewport -->
      <div id="fundus-scanner-container" class="my-6 py-2 relative flex flex-col items-center justify-center cursor-crosshair group/scanner select-none">
        
        <!-- 45° Wide-Angle Fundus Lens Viewport -->
        <div class="relative w-56 h-56 flex items-center justify-center rounded-full bg-[#040D18]/90 border border-[#00A396]/30 shadow-[0_0_30px_rgba(0,163,150,0.15),inset_0_0_25px_rgba(0,0,0,0.8)] overflow-hidden">
          
          <!-- Radial Lens Polar Grid Background -->
          <svg class="absolute inset-0 w-full h-full text-[#00A396]/20 pointer-events-none" viewBox="0 0 200 200" fill="none">
            <!-- Polar Range Rings -->
            <circle cx="100" cy="100" r="90" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 4" />
            <circle cx="100" cy="100" r="65" stroke="currentColor" stroke-width="0.5" stroke-dasharray="1 3" />
            <circle cx="100" cy="100" r="40" stroke="rgba(34,211,238,0.2)" stroke-width="0.75" />
            
            <!-- Axis Guides -->
            <line x1="10" y1="100" x2="190" y2="100" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 4" />
            <line x1="100" y1="10" x2="100" y2="190" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 4" />
            
            <!-- Angle Degree Marks -->
            <text x="100" y="16" text-anchor="middle" fill="#00A396" font-size="6" font-family="monospace" opacity="0.6">0°</text>
            <text x="186" y="102" text-anchor="middle" fill="#00A396" font-size="6" font-family="monospace" opacity="0.6">90°</text>
            <text x="100" y="188" text-anchor="middle" fill="#00A396" font-size="6" font-family="monospace" opacity="0.6">180°</text>
            <text x="14" y="102" text-anchor="middle" fill="#00A396" font-size="6" font-family="monospace" opacity="0.6">270°</text>
          </svg>

          <!-- Retinal Vascular Network & Macula Optical Map -->
          <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 200 200" fill="none">
            <!-- Optic Disc (시신경 유두 - Nasal side) -->
            <g id="target-optic-disc" class="transition-all duration-300">
              <circle cx="72" cy="100" r="14" fill="#22D3EE" fill-opacity="0.12" stroke="#22D3EE" stroke-width="1" class="drop-shadow-[0_0_8px_rgba(34,211,238,0.4)]" />
              <circle cx="72" cy="100" r="7" fill="#22D3EE" fill-opacity="0.25" />
              <circle cx="72" cy="100" r="2.5" fill="#FFFFFF" />
            </g>

            <!-- Retinal Vessels Branching (망막 혈관망) -->
            <path d="M 72 100 Q 85 70 120 50 Q 150 40 170 35" stroke="#00A396" stroke-width="1.2" stroke-linecap="round" opacity="0.75" />
            <path d="M 72 100 Q 85 130 125 150 Q 155 160 175 165" stroke="#00A396" stroke-width="1.2" stroke-linecap="round" opacity="0.75" />
            <path d="M 72 100 Q 55 65 30 50" stroke="#00A396" stroke-width="1" stroke-linecap="round" opacity="0.5" />
            <path d="M 72 100 Q 55 135 30 150" stroke="#00A396" stroke-width="1" stroke-linecap="round" opacity="0.5" />
            <path d="M 85 70 Q 100 80 125 78" stroke="#22D3EE" stroke-width="0.75" opacity="0.6" stroke-dasharray="2 2" />
            <path d="M 85 130 Q 105 120 125 122" stroke="#22D3EE" stroke-width="0.75" opacity="0.6" stroke-dasharray="2 2" />

            <!-- Macula & Fovea (황반 및 중심와 - Temporal Center) -->
            <g id="target-macula" class="transition-all duration-300">
              <circle cx="125" cy="100" r="18" stroke="#00A396" stroke-width="1" stroke-dasharray="3 3" class="animate-pulse" />
              <circle cx="125" cy="100" r="9" fill="#00A396" fill-opacity="0.25" stroke="#22D3EE" stroke-width="1" />
              <circle cx="125" cy="100" r="3" fill="#22D3EE" class="shadow-[0_0_8px_#22D3EE]" />
              <circle cx="125" cy="100" r="1" fill="#FFFFFF" />
            </g>

            <!-- GazeInto Overlapping Focal Reticle (Symbolic Optic Signature) -->
            <circle cx="92" cy="100" r="28" stroke="rgba(255,255,255,0.4)" stroke-width="1" />
            <circle cx="108" cy="100" r="28" stroke="#00A396" stroke-width="1" />
          </svg>

          <!-- 360° Rotating Radar Scanning Beam -->
          <div class="absolute inset-0 rounded-full bg-[conic-gradient(from_0deg,transparent_0deg,transparent_270deg,rgba(34,211,238,0.25)_360deg)] animate-spin-slow pointer-events-none"></div>

          <!-- Interactive Mouse-Tracking Target Crosshair -->
          <div id="scanner-aim-crosshair" class="absolute w-12 h-12 pointer-events-none flex items-center justify-center transition-transform duration-75 ease-out">
            <div class="w-8 h-8 rounded-full border border-[#22D3EE] shadow-[0_0_10px_#22D3EE] flex items-center justify-center">
              <div class="w-1.5 h-1.5 rounded-full bg-[#22D3EE] animate-ping"></div>
            </div>
            <!-- Target Cross lines -->
            <div class="absolute -top-1 w-0.5 h-2 bg-[#22D3EE]"></div>
            <div class="absolute -bottom-1 w-0.5 h-2 bg-[#22D3EE]"></div>
            <div class="absolute -left-1 w-2 h-0.5 bg-[#22D3EE]"></div>
            <div class="absolute -right-1 w-2 h-0.5 bg-[#22D3EE]"></div>
          </div>

          <!-- Dynamic Biomarker Alert Badges on Lens -->
          <div class="absolute top-3 left-3 bg-[#081726]/85 backdrop-blur-md border border-[#00A396]/30 px-2 py-0.5 rounded text-[8px] font-mono text-[#22D3EE] flex items-center gap-1">
            <span class="w-1 h-1 rounded-full bg-[#22D3EE] animate-pulse"></span>
            <span>FUNDUS 45°</span>
          </div>

          <div class="absolute bottom-3 right-3 bg-[#081726]/85 backdrop-blur-md border border-[#00A396]/30 px-2 py-0.5 rounded text-[8px] font-mono text-[#00A396] flex items-center gap-1">
            <span class="w-1 h-1 rounded-full bg-[#00A396]"></span>
            <span>AI SCAN // ACTIVE</span>
          </div>
        </div>

        <!-- Realtime Disease Screening Status Stream -->
        <div class="mt-3 w-full max-w-[240px] space-y-1.5">
          <!-- Biomarker 1: Macula (AMD) -->
          <div class="flex items-center justify-between px-2.5 py-1 rounded bg-slate-900/60 border border-slate-800 text-[9px] font-mono transition-colors duration-200" id="bio-amd">
            <div class="flex items-center gap-1.5 text-slate-300">
              <span class="w-1 h-1 rounded-full bg-[#22D3EE]"></span>
              <span>황반 (Macula AMD)</span>
            </div>
            <span class="text-[#22D3EE] font-semibold">정상 (Risk &lt;1%)</span>
          </div>

          <!-- Biomarker 2: Optic Disc (Glaucoma) -->
          <div class="flex items-center justify-between px-2.5 py-1 rounded bg-slate-900/60 border border-slate-800 text-[9px] font-mono transition-colors duration-200" id="bio-glaucoma">
            <div class="flex items-center gap-1.5 text-slate-300">
              <span class="w-1 h-1 rounded-full bg-[#00A396]"></span>
              <span>시신경 (Glaucoma)</span>
            </div>
            <span class="text-[#00A396] font-semibold">C/D 0.32 안정</span>
          </div>

          <!-- Biomarker 3: Vessels (DR) -->
          <div class="flex items-center justify-between px-2.5 py-1 rounded bg-slate-900/60 border border-slate-800 text-[9px] font-mono transition-colors duration-200" id="bio-dr">
            <div class="flex items-center gap-1.5 text-slate-300">
              <span class="w-1 h-1 rounded-full bg-slate-400"></span>
              <span>망막혈관 (DR)</span>
            </div>
            <span class="text-slate-300 font-semibold">Clear</span>
          </div>
        </div>

      </div>

      <!-- Bottom Section: Recommended Add & Output -->
      <div class="pt-6 border-t border-slate-800/80 relative z-10">
        <div class="font-mono text-[11px] font-bold tracking-[0.2em] text-[#94A3B8] uppercase mb-2">
          RECOMMENDED ADD
        </div>
        
        <div class="flex items-baseline gap-1 text-white mb-2">
          <span id="hero-add-display" class="text-5xl sm:text-6xl font-black font-mono tracking-tight text-white drop-shadow-sm transition-all duration-300">
            +1.75
          </span>
        </div>

        <p class="text-xs text-slate-400 font-normal leading-relaxed flex items-center justify-between">
          <span>근거리 업무 비중 기반 보정값</span>
          <span class="font-mono text-[10px] text-[#22D3EE]">LIVE OPTIC</span>
        </p>
      </div>

    </div>

  </div>

</section>

<script>
  // Distance Gauge Logic
  const addDisplay = document.getElementById('hero-add-display');
  const gaugeItems = document.querySelectorAll('.distance-gauge-item');
  const scanBeam = document.getElementById('gauge-scan-beam');

  let activeIndex = 1; // Default at 33cm
  let isUserHoveringGauge = false;

  const positions = [4, 40, 78, 116, 154]; // Y offsets for beam

  function setActiveGauge(index: number) {
    gaugeItems.forEach((item, i) => {
      const line = item.querySelector('.gauge-line') as HTMLElement;
      const num = item.querySelector('.gauge-num') as HTMLElement;
      const addVal = item.getAttribute('data-add');

      if (i === index) {
        item.classList.add('is-active');
        if (line) {
          line.style.opacity = '1';
          line.style.boxShadow = '0 0 12px rgba(34, 211, 238, 0.9)';
          line.style.backgroundColor = '#22D3EE';
        }
        if (num) {
          num.style.color = '#22D3EE';
          num.style.fontWeight = '700';
        }
        if (addDisplay && addVal) {
          addDisplay.textContent = addVal;
        }
      } else {
        item.classList.remove('is-active');
        if (line) {
          line.style.boxShadow = 'none';
          line.style.backgroundColor = i > 2 ? '#1E3A52' : (i === 2 ? '#00A396' : '#22D3EE');
          line.style.opacity = i > 2 ? '0.4' : '0.6';
        }
        if (num) {
          num.style.color = '';
          num.style.fontWeight = '400';
        }
      }
    });

    if (scanBeam && positions[index] !== undefined) {
      scanBeam.style.top = `${positions[index]}px`;
    }
  }

  // Automatic Sequential Laser Wave cycle every 2.6s when not hovering
  setInterval(() => {
    if (!isUserHoveringGauge) {
      activeIndex = (activeIndex + 1) % gaugeItems.length;
      setActiveGauge(activeIndex);
    }
  }, 2600);

  // Manual hover immediately highlights item
  gaugeItems.forEach((item, idx) => {
    item.addEventListener('mouseenter', () => {
      isUserHoveringGauge = true;
      setActiveGauge(idx);
    });

    item.addEventListener('mouseleave', () => {
      isUserHoveringGauge = false;
    });
  });

  // Init Gauge
  setActiveGauge(1);

  // ==============================================================
  // Interactive Fundus Retina AI Scanner Crosshair Tracking
  // ==============================================================
  const scannerContainer = document.getElementById('fundus-scanner-container');
  const crosshair = document.getElementById('scanner-aim-crosshair');
  const bioAmd = document.getElementById('bio-amd');
  const bioGlaucoma = document.getElementById('bio-glaucoma');
  const bioDr = document.getElementById('bio-dr');

  let targetX = 0;
  let targetY = 0;
  let currentX = 0;
  let currentY = 0;
  let isHovering = false;
  let idleTime = 0;

  window.addEventListener('mousemove', (e) => {
    if (!scannerContainer) return;
    const rect = scannerContainer.getBoundingClientRect();
    const centerX = rect.left + rect.width / 2;
    const centerY = rect.top + rect.height / 2;

    const deltaX = e.clientX - centerX;
    const deltaY = e.clientY - centerY;

    targetX = Math.max(-1, Math.min(1, deltaX / (window.innerWidth * 0.4)));
    targetY = Math.max(-1, Math.min(1, deltaY / (window.innerHeight * 0.4)));
    isHovering = true;
    idleTime = 0;
  });

  function renderScanner() {
    if (!isHovering) {
      idleTime += 0.03;
      targetX = Math.sin(idleTime * 0.8) * 0.45;
      targetY = Math.cos(idleTime * 0.6) * 0.35;
    }

    currentX += (targetX - currentX) * 0.09;
    currentY += (targetY - currentY) * 0.09;

    const maxShift = 55; // pixels travel radius on lens
    const crossX = currentX * maxShift;
    const crossY = currentY * maxShift;

    if (crosshair) {
      crosshair.style.transform = `translate(${crossX}px, ${crossY}px)`;
    }

    // Dynamic Biomarker Highlights based on position
    if (bioAmd && bioGlaucoma && bioDr) {
      // Right temporal is Macula
      if (currentX > 0.2) {
        bioAmd.classList.add('border-[#22D3EE]', 'bg-[#22D3EE]/10');
        bioGlaucoma.classList.remove('border-[#00A396]', 'bg-[#00A396]/10');
        bioDr.classList.remove('border-slate-500', 'bg-slate-800');
      } 
      // Left nasal is Optic Disc
      else if (currentX < -0.2) {
        bioGlaucoma.classList.add('border-[#00A396]', 'bg-[#00A396]/10');
        bioAmd.classList.remove('border-[#22D3EE]', 'bg-[#22D3EE]/10');
        bioDr.classList.remove('border-slate-500', 'bg-slate-800');
      } 
      // Center vessels
      else {
        bioDr.classList.add('border-slate-500', 'bg-slate-800');
        bioAmd.classList.remove('border-[#22D3EE]', 'bg-[#22D3EE]/10');
        bioGlaucoma.classList.remove('border-[#00A396]', 'bg-[#00A396]/10');
      }
    }

    requestAnimationFrame(renderScanner);
  }

  renderScanner();
</script>







