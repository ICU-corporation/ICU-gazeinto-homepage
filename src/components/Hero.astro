---
---

<section id="hero" class="relative min-h-[100dvh] xl:h-[100dvh] pt-16 sm:pt-20 pb-3 sm:pb-5 flex flex-col justify-between bg-[#0A1928] overflow-hidden select-none" aria-label="GazeInto Cockpit Dashboard">
  
  <!-- Ambient High-Definition Video Background Layer with Fallback Poster -->
  <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none z-0">
    <video
      id="hero-bg-video"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      poster="/videos/hero-bg-poster.jpg"
      class="w-full h-full object-cover object-center opacity-90 scale-100"
    >
      <source src="/videos/hero-bg.mp4" type="video/mp4" />
    </video>
    
    <!-- 1. Global Ambient Translucent White Veil -->
    <div class="absolute inset-0 bg-white/45 backdrop-blur-[1px]"></div>

    <!-- 2. Left-to-Right Sophisticated White Scrim Gradient (Crystal clear typography on left) -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#F8FAFC]/98 via-[#F8FAFC]/80 to-[#F8FAFC]/30"></div>

    <!-- 3. Bottom-to-Top White Gradient (Soft transition behind cards) -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#F8FAFC]/95 via-[#F8FAFC]/40 to-transparent"></div>
  </div>

  <!-- Main Container: Top Left Typography + Bottom Cards -->
  <div class="relative z-10 w-full max-w-7xl xl:max-w-[1570px] 2xl:max-w-[1630px] qhd:max-w-[2050px] 4k:max-w-[2750px] mx-auto px-4 sm:px-6 lg:px-8 xl:px-10 flex-1 flex flex-col justify-between pt-3 sm:pt-6 lg:pt-8 qhd:pt-16 pb-2 sm:pb-3 lg:pb-4 qhd:pb-8">
    
    <!-- Top-Left Content Section: Main Typography & Copy (Comfortably Scaled) -->
    <div class="max-w-sm sm:max-w-lg lg:max-w-xl xl:max-w-2xl qhd:max-w-3xl 4k:max-w-4xl pt-14 sm:pt-20 md:pt-24 lg:pt-28 xl:pt-36 qhd:pt-52 4k:pt-64">
      
      <!-- Category Tag -->
      <div class="flex items-center gap-2 mb-2 sm:mb-2.5 qhd:mb-4 scroll-reveal">
        <span class="w-4 sm:w-5 qhd:w-7 h-[2.5px] bg-[#00A396] scroll-line"></span>
        <span data-i18n="hero_category" class="text-[11px] sm:text-[14px] md:text-[15px] qhd:text-lg 4k:text-xl font-semibold tracking-[0.18em] text-[#00A396] uppercase drop-shadow-sm">
          노안 AI 진단 & 처방 엔진
        </span>
      </div>

      <!-- Headline (Blur to Sharp Typography with Interactive Hover Focus) -->
      <div class="mb-2.5 sm:mb-3 qhd:mb-5 select-none">
        <h1 class="text-[23px] sm:text-[34px] md:text-[38px] lg:text-[42px] xl:text-[44px] qhd:text-6xl 4k:text-7xl font-bold text-slate-900 tracking-tight leading-[1.18] break-keep drop-shadow-sm">
          <!-- Line 1: Blurred text that clarifies on hover -->
          <span id="hero-blurred-text" data-i18n="hero_title_blur" class="blur-presbyopia inline-block cursor-default transition-all duration-700" title="초점이 흐려진 상태 (마우스를 올리면 선명해집니다)">
            흐려진 글자 앞에서
          </span>
          <br />
          <!-- Line 2: Sharp text -->
          <span data-i18n="hero_title_sharp" class="text-slate-900 inline-block mt-0.5 sm:mt-1 scroll-reveal scroll-reveal-delay-1">
            멈추지 않도록.
          </span>
        </h1>
      </div>

      <!-- Description Paragraph -->
      <div class="max-w-xs sm:max-w-md lg:max-w-lg xl:max-w-xl qhd:max-w-2xl 4k:max-w-3xl mb-2 sm:mb-3 qhd:mb-5">
        <p data-i18n="hero_desc" class="text-[13px] sm:text-[14.5px] md:text-[15.5px] lg:text-[16.5px] xl:text-[17px] qhd:text-xl 4k:text-2xl text-slate-700 font-normal leading-[1.38] sm:leading-[1.4] break-keep scroll-reveal scroll-reveal-delay-2 drop-shadow-sm">
          게이즈인투의 AI는 노안의 진행 단계를 정량 판독하고, 당신의 눈이 실제로 머무는 거리에 맞춰 처방을 설계합니다.
        </p>
      </div>

    </div>

    <!-- Bottom Section: 4 Horizontal Side-by-Side Cards -->
    <div class="w-full mt-auto pt-1 pb-1 sm:pb-2">

      <!-- Mobile Quick Tab Selector (Visible on small screens for easy thumb switching) -->
      <div class="md:hidden flex items-center justify-between gap-1 p-1 bg-white/80 backdrop-blur-md rounded-2xl border border-slate-200/80 mb-2 text-xs font-bold shadow-xs">
        <button type="button" onclick="window.selectHeroCard(0)" id="m-tab-0" class="flex-1 py-1.5 rounded-xl text-center transition-all bg-[#00A396] text-white shadow-xs">01 대시보드</button>
        <button type="button" onclick="window.selectHeroCard(1)" id="m-tab-1" class="flex-1 py-1.5 rounded-xl text-center transition-all text-slate-600 hover:text-slate-900">02 기술</button>
        <button type="button" onclick="window.selectHeroCard(2)" id="m-tab-2" class="flex-1 py-1.5 rounded-xl text-center transition-all text-slate-600 hover:text-slate-900">03 임상</button>
        <button type="button" onclick="window.selectHeroCard(3)" id="m-tab-3" class="flex-1 py-1.5 rounded-xl text-center transition-all text-slate-600 hover:text-slate-900">04 FAQ</button>
      </div>
      
      <!-- Responsive Grid: 1 col on Mobile, 2x2 grid on Tablet (iPad portrait/landscape), 4 cols on Desktop/Laptop -->
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-2.5 sm:gap-3 lg:gap-3.5 qhd:gap-6 4k:gap-8 w-full" id="hero-card-grid" role="tablist" aria-label="Dashboard Cockpit Cards">
        
        <!-- ========================================================= -->
        <!-- CARD 0: 01 대시보드 (Live Prescribed Optic) -->
        <!-- ========================================================= -->
        <div
          id="hero-card-0"
          role="tab"
          tabindex="0"
          aria-selected="true"
          aria-label="01 LIVE PRESCRIBED OPTIC"
          onclick="window.selectHeroCard(0)"
          class="hero-bottom-card rounded-2xl lg:rounded-3xl p-3 sm:p-3.5 lg:p-4 qhd:p-6 4k:p-8 flex flex-col justify-between cursor-pointer transition-all duration-300 ease-out bg-white/95 backdrop-blur-xl border-2 border-[#00A396]/60 shadow-lg ring-2 ring-[#00A396]/20 min-h-[225px] sm:min-h-[235px] lg:min-h-[245px] qhd:min-h-[300px] 4k:min-h-[380px] z-20 focus:outline-none focus:ring-4 focus:ring-[#00A396]/40"
        >
          <!-- Card Header -->
          <div class="flex items-center justify-between pb-2 border-b border-slate-200/70 gap-1.5">
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="w-2 h-2 rounded-full bg-[#00A396] shadow-[0_0_6px_#00A396] shrink-0"></span>
              <span data-i18n="card0_title" class="text-[10.5px] sm:text-xs qhd:text-sm 4k:text-base font-extrabold tracking-wider text-slate-900 uppercase truncate">
                01 / LIVE PRESCRIBED OPTIC
              </span>
            </div>
            <span data-i18n="card0_badge" class="text-[8px] sm:text-[9px] qhd:text-xs px-1.5 py-0.5 rounded-full bg-[#00A396]/15 text-[#00A396] font-bold border border-[#00A396]/30 shrink-0 whitespace-nowrap">
              AUTO CALIBRATE
            </span>
          </div>

          <!-- Card Body: Distance buttons + Output + Biomarkers -->
          <div class="space-y-1.5 qhd:space-y-2.5 my-auto">
            <div class="flex items-center justify-between text-xs gap-1">
              <span data-i18n="card0_dist_label" class="text-slate-600 font-semibold text-[10px] sm:text-[11px] qhd:text-xs truncate">거리별 처방 가입도</span>
              <span data-i18n="card0_dist_tag" class="font-bold text-[#00A396] text-[9px] sm:text-[10px] qhd:text-xs shrink-0 whitespace-nowrap">실시간 AI 거리 보정</span>
            </div>

            <!-- Distance Display Grid (Static Visual Gauge) -->
            <div class="grid grid-cols-5 gap-1 qhd:gap-2 pointer-events-none select-none" id="hero-dist-boxes" aria-label="Reading Distance Gauge">
              <div class="p-1 qhd:p-2 rounded-lg lg:rounded-xl border border-slate-200 bg-slate-50 text-center min-w-0">
                <div class="text-[7px] sm:text-[8px] qhd:text-[10px] text-slate-400">25cm</div>
                <div class="text-[10px] sm:text-[11px] qhd:text-sm font-bold text-slate-700">+2.25</div>
              </div>
              <div class="p-1 qhd:p-2 rounded-lg lg:rounded-xl border-2 border-[#00A396] bg-[#00A396]/10 text-center shadow-xs min-w-0">
                <div class="text-[7px] sm:text-[8px] qhd:text-[10px] text-[#00A396] font-bold">33cm★</div>
                <div class="text-[10px] sm:text-[11px] qhd:text-sm font-black text-[#00A396]">+1.75</div>
              </div>
              <div class="p-1 qhd:p-2 rounded-lg lg:rounded-xl border border-slate-200 bg-slate-50 text-center min-w-0">
                <div class="text-[7px] sm:text-[8px] qhd:text-[10px] text-slate-400">45cm</div>
                <div class="text-[10px] sm:text-[11px] qhd:text-sm font-bold text-slate-700">+1.25</div>
              </div>
              <div class="p-1 qhd:p-2 rounded-lg lg:rounded-xl border border-slate-200 bg-slate-50 text-center min-w-0">
                <div class="text-[7px] sm:text-[8px] qhd:text-[10px] text-slate-400">60cm</div>
                <div class="text-[10px] sm:text-[11px] qhd:text-sm font-bold text-slate-700">+0.75</div>
              </div>
              <div class="p-1 qhd:p-2 rounded-lg lg:rounded-xl border border-slate-200 bg-slate-50 text-center min-w-0">
                <div class="text-[7px] sm:text-[8px] qhd:text-[10px] text-slate-400">80cm</div>
                <div class="text-[10px] sm:text-[11px] qhd:text-sm font-bold text-slate-700">+0.50</div>
              </div>
            </div>

            <!-- Output Display -->
            <div class="p-1.5 sm:p-2 qhd:p-3 rounded-xl lg:rounded-2xl bg-[#081726] text-white flex items-center justify-between shadow-xs gap-2">
              <div class="min-w-0">
                <span data-i18n="card0_rec_title" class="text-[7px] sm:text-[8px] qhd:text-[10px] text-[#22D3EE] uppercase tracking-wider font-bold block truncate">RECOMMENDED ADD</span>
                <span data-i18n="card0_rec_desc" class="text-[9.5px] sm:text-[10.5px] md:text-[11px] qhd:text-xs text-slate-300 break-keep leading-tight">근거리 작업 맞춤 처방</span>
              </div>
              <div class="flex items-baseline gap-1 shrink-0">
                <span id="hero-live-add-val" class="text-lg sm:text-xl qhd:text-3xl 4k:text-4xl font-black text-white tracking-tight">+1.75</span>
                <span class="text-[10px] sm:text-xs qhd:text-sm text-[#00C4B4] font-bold">D</span>
              </div>
            </div>

            <!-- 3 Biomarker mini tags -->
            <div class="grid grid-cols-3 gap-1 text-center text-[8px] sm:text-[9px] qhd:text-xs">
              <div data-i18n-html="card0_bio_amd" class="p-1 rounded-lg bg-slate-100/90 border border-slate-200/80 text-slate-700 font-bold truncate">
                AMD <span class="text-[#00A396]">&lt;1%</span>
              </div>
              <div data-i18n-html="card0_bio_glaucoma" class="p-1 rounded-lg bg-slate-100/90 border border-slate-200/80 text-slate-700 font-bold truncate">
                녹내장 <span class="text-[#00A396]">0.32</span>
              </div>
              <div data-i18n-html="card0_bio_dr" class="p-1 rounded-lg bg-slate-100/90 border border-slate-200/80 text-slate-700 font-bold truncate">
                DR <span class="text-slate-900">Clear</span>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================================= -->
        <!-- CARD 1: 02 기술 (All-In-One XR Workflow) -->
        <!-- ========================================================= -->
        <div
          id="hero-card-1"
          role="tab"
          tabindex="0"
          aria-selected="false"
          aria-label="02 ALL-IN-ONE XR WORKFLOW"
          onclick="window.selectHeroCard(1)"
          class="hero-bottom-card rounded-2xl lg:rounded-3xl p-3 sm:p-3.5 lg:p-4 qhd:p-6 4k:p-8 hidden md:flex flex-col justify-between cursor-pointer transition-all duration-300 ease-out bg-white/50 hover:bg-white/75 backdrop-blur-md border border-white/60 shadow-xs min-h-[225px] sm:min-h-[235px] lg:min-h-[245px] qhd:min-h-[300px] 4k:min-h-[380px] opacity-90 hover:opacity-100 z-10 focus:outline-none focus:ring-4 focus:ring-[#00A396]/40"
        >
          <!-- Card Header -->
          <div class="flex items-center justify-between pb-2 border-b border-slate-200/60 gap-1.5">
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="w-2 h-2 rounded-full bg-[#00A396] shrink-0"></span>
              <span data-i18n="card1_title" class="text-[10.5px] sm:text-xs qhd:text-sm 4k:text-base font-extrabold tracking-wider text-slate-900 uppercase truncate">
                02 / XR WORKFLOW
              </span>
            </div>
            <span data-i18n="card1_badge" class="text-[8px] sm:text-[9px] qhd:text-xs px-1.5 py-0.5 rounded-full bg-[#00A396]/15 text-[#00A396] font-bold border border-[#00A396]/30 shrink-0 whitespace-nowrap">
              3-STEP PROCESS
            </span>
          </div>

          <!-- Card Body: 3 Detailed Step Rows -->
          <div class="space-y-1 sm:space-y-1.5 qhd:space-y-2.5 my-auto text-xs">
            <div class="p-1.5 sm:p-2 qhd:p-3 rounded-xl lg:rounded-2xl bg-white/85 border border-slate-200/80 flex items-start gap-1.5 qhd:gap-2.5 shadow-2xs">
              <span class="font-black text-[#00A396] text-[10px] sm:text-[11px] qhd:text-xs px-1.5 py-0.5 rounded-md bg-[#00A396]/10 shrink-0 mt-0.5">01</span>
              <div class="min-w-0">
                <div data-i18n="card1_step1_title" class="font-bold text-slate-900 text-[10.5px] sm:text-xs qhd:text-sm truncate">자가 착용 (Wear)</div>
                <div data-i18n="card1_step1_desc" class="text-[9px] sm:text-[10px] qhd:text-xs text-slate-600 leading-tight mt-0.5 break-keep">병원 방문 없이 일상에서 착용 후 즉시 시작</div>
              </div>
            </div>
            <div class="p-1.5 sm:p-2 qhd:p-3 rounded-xl lg:rounded-2xl bg-white/85 border border-slate-200/80 flex items-start gap-1.5 qhd:gap-2.5 shadow-2xs">
              <span class="font-black text-[#00A396] text-[10px] sm:text-[11px] qhd:text-xs px-1.5 py-0.5 rounded-md bg-[#00A396]/10 shrink-0 mt-0.5">02</span>
              <div class="min-w-0">
                <div data-i18n="card1_step2_title" class="font-bold text-slate-900 text-[10.5px] sm:text-xs qhd:text-sm truncate">시선 유도 자동 촬영</div>
                <div data-i18n="card1_step2_desc" class="text-[9px] sm:text-[10px] qhd:text-xs text-slate-600 leading-tight mt-0.5 break-keep">지능형 동공 정렬로 고해상도 안저 캡처</div>
              </div>
            </div>
            <div class="p-1.5 sm:p-2 qhd:p-3 rounded-xl lg:rounded-2xl bg-white/85 border border-slate-200/80 flex items-start gap-1.5 qhd:gap-2.5 shadow-2xs">
              <span class="font-black text-[#00A396] text-[10px] sm:text-[11px] qhd:text-xs px-1.5 py-0.5 rounded-md bg-[#00A396]/10 shrink-0 mt-0.5">03</span>
              <div class="min-w-0">
                <div data-i18n="card1_step3_title" class="font-bold text-slate-900 text-[10.5px] sm:text-xs qhd:text-sm truncate">3대 질환 온디바이스 판독</div>
                <div data-i18n="card1_step3_desc" class="text-[9px] sm:text-[10px] qhd:text-xs text-slate-600 leading-tight mt-0.5 break-keep">AMD, 녹내장, 당뇨망막 30초 내 정량 분석</div>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================================= -->
        <!-- CARD 2: 03 임상 근거 (Clinical Matrix) -->
        <!-- ========================================================= -->
        <div
          id="hero-card-2"
          role="tab"
          tabindex="0"
          aria-selected="false"
          aria-label="03 CLINICAL MATRIX"
          onclick="window.selectHeroCard(2)"
          class="hero-bottom-card rounded-2xl lg:rounded-3xl p-3 sm:p-3.5 lg:p-4 qhd:p-6 4k:p-8 hidden md:flex flex-col justify-between cursor-pointer transition-all duration-300 ease-out bg-white/50 hover:bg-white/75 backdrop-blur-md border border-white/60 shadow-xs min-h-[225px] sm:min-h-[235px] lg:min-h-[245px] qhd:min-h-[300px] 4k:min-h-[380px] opacity-90 hover:opacity-100 z-10 focus:outline-none focus:ring-4 focus:ring-[#00A396]/40"
        >
          <!-- Card Header -->
          <div class="flex items-center justify-between pb-2 border-b border-slate-200/60 gap-1.5">
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="w-2 h-2 rounded-full bg-[#00A396] shrink-0"></span>
              <span data-i18n="card2_title" class="text-[10.5px] sm:text-xs qhd:text-sm 4k:text-base font-extrabold tracking-wider text-slate-900 uppercase truncate">
                03 / CLINICAL MATRIX
              </span>
            </div>
            <span data-i18n="card2_badge" class="text-[8px] sm:text-[9px] qhd:text-xs px-1.5 py-0.5 rounded-full bg-[#00A396]/15 text-[#00A396] font-bold border border-[#00A396]/30 shrink-0 whitespace-nowrap">
              CLINICAL VALIDATED
            </span>
          </div>

          <!-- Card Body: 3 Biomarkers + Clinical Stats Table -->
          <div class="space-y-1.5 qhd:space-y-2.5 my-auto text-xs">
            <!-- 3 Target Diseases -->
            <div class="grid grid-cols-3 gap-1 qhd:gap-2 text-center">
              <div class="p-1 sm:p-1.5 qhd:p-2 rounded-lg lg:rounded-xl bg-white/85 border border-slate-200/80 shadow-2xs min-w-0">
                <div data-i18n="card2_amd_label" class="text-slate-500 font-medium text-[8px] sm:text-[9px] qhd:text-xs truncate">황반변성(AMD)</div>
                <div data-i18n="card2_amd_val" class="font-bold text-[#00A396] text-[9.5px] sm:text-[10.5px] qhd:text-sm mt-0.5 truncate">&lt;1%</div>
              </div>
              <div class="p-1 sm:p-1.5 qhd:p-2 rounded-lg lg:rounded-xl bg-white/85 border border-slate-200/80 shadow-2xs min-w-0">
                <div data-i18n="card2_glaucoma_label" class="text-slate-500 font-medium text-[8px] sm:text-[9px] qhd:text-xs truncate">녹내장</div>
                <div data-i18n="card2_glaucoma_val" class="font-bold text-[#00A396] text-[9.5px] sm:text-[10.5px] qhd:text-sm mt-0.5 truncate">0.32</div>
              </div>
              <div class="p-1 sm:p-1.5 qhd:p-2 rounded-lg lg:rounded-xl bg-white/85 border border-slate-200/80 shadow-2xs min-w-0">
                <div data-i18n="card2_dr_label" class="text-slate-500 font-medium text-[8px] sm:text-[9px] qhd:text-xs truncate">당뇨망막(DR)</div>
                <div data-i18n="card2_dr_val" class="font-bold text-slate-800 text-[9.5px] sm:text-[10.5px] qhd:text-sm mt-0.5 truncate">Clear</div>
              </div>
            </div>

            <!-- Big Stat Badge -->
            <div class="p-1.5 sm:p-2 qhd:p-3 rounded-xl lg:rounded-2xl bg-slate-900 text-white flex items-center justify-between text-xs shadow-2xs">
              <div class="text-center flex-1 min-w-0 px-0.5">
                <div class="font-black text-xs sm:text-sm qhd:text-xl text-[#00C4B4] truncate">98.4%</div>
                <div data-i18n="card2_stat_acc" class="text-[7px] sm:text-[8px] qhd:text-xs text-slate-400 truncate">일치율</div>
              </div>
              <span class="text-slate-700 shrink-0">|</span>
              <div class="text-center flex-1 min-w-0 px-0.5">
                <div class="font-black text-xs sm:text-sm qhd:text-xl text-white truncate">4개</div>
                <div data-i18n="card2_stat_hosp" class="text-[7px] sm:text-[8px] qhd:text-xs text-slate-400 truncate">협력 안과</div>
              </div>
              <span class="text-slate-700 shrink-0">|</span>
              <div class="text-center flex-1 min-w-0 px-0.5">
                <div class="font-black text-xs sm:text-sm qhd:text-xl text-white truncate">12만+</div>
                <div data-i18n="card2_stat_data" class="text-[7px] sm:text-[8px] qhd:text-xs text-slate-400 truncate">학습 데이터</div>
              </div>
            </div>

            <div data-i18n="card2_irb_badge" class="p-1 qhd:p-2 rounded-lg lg:rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-center text-[8px] sm:text-[9px] qhd:text-xs text-emerald-800 font-semibold break-keep leading-tight">
              ✓ 대학병원 임상 실증 및 IRB 승인 완료
            </div>
          </div>
        </div>

        <!-- ========================================================= -->
        <!-- CARD 3: 04 FAQ & SUPPORT (Frequently Asked Questions) -->
        <!-- ========================================================= -->
        <div
          id="hero-card-3"
          role="tab"
          tabindex="0"
          aria-selected="false"
          aria-label="04 FAQ & SUPPORT"
          onclick="window.selectHeroCard(3)"
          class="hero-bottom-card rounded-2xl lg:rounded-3xl p-3 sm:p-3.5 lg:p-4 qhd:p-6 4k:p-8 hidden md:flex flex-col justify-between cursor-pointer transition-all duration-300 ease-out bg-white/50 hover:bg-white/75 backdrop-blur-md border border-white/60 shadow-xs min-h-[225px] sm:min-h-[235px] lg:min-h-[245px] qhd:min-h-[300px] 4k:min-h-[380px] opacity-90 hover:opacity-100 z-10 focus:outline-none focus:ring-4 focus:ring-[#00A396]/40"
        >
          <!-- Card Header -->
          <div class="flex items-center justify-between pb-2 border-b border-slate-200/60 gap-1.5">
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="w-2 h-2 rounded-full bg-[#00A396] shrink-0"></span>
              <span data-i18n="card3_title" class="text-[10.5px] sm:text-xs qhd:text-sm 4k:text-base font-extrabold tracking-wider text-slate-900 uppercase truncate">
                04 / FAQ & SUPPORT
              </span>
            </div>
            <span data-i18n="card3_badge" class="text-[8px] sm:text-[9px] qhd:text-xs px-1.5 py-0.5 rounded-full bg-[#00A396]/15 text-[#00A396] font-bold border border-[#00A396]/30 shrink-0 whitespace-nowrap">
              FAQ & SUPPORT
            </span>
          </div>

          <!-- Card Body: 3 Expanded Q&As -->
          <div class="space-y-1 sm:space-y-1.5 qhd:space-y-2.5 my-auto text-xs">
            <div class="p-1.5 sm:p-2 qhd:p-3 rounded-xl lg:rounded-2xl bg-white/85 border border-slate-200/80 shadow-2xs">
              <span data-i18n="card3_q1_title" class="font-bold text-slate-900 text-[10px] sm:text-[11px] qhd:text-xs block leading-snug">Q1. 혼자서 촬영 가능한가요?</span>
              <p data-i18n="card3_q1_desc" class="text-[8px] sm:text-[9px] qhd:text-[11px] text-slate-600 leading-tight mt-0.5 break-keep">시선 유도로 비숙련자도 30초 내 촬영</p>
            </div>
            <div class="p-1.5 sm:p-2 qhd:p-3 rounded-xl lg:rounded-2xl bg-white/85 border border-slate-200/80 shadow-2xs">
              <span data-i18n="card3_q2_title" class="font-bold text-slate-900 text-[10px] sm:text-[11px] qhd:text-xs block leading-snug">Q2. 안경원·의원 EMR 연동</span>
              <p data-i18n="card3_q2_desc" class="text-[8px] sm:text-[9px] qhd:text-[11px] text-slate-600 leading-tight mt-0.5 break-keep">처방 및 리포트를 기존 EMR과 즉시 연동</p>
            </div>
            <div class="p-1.5 sm:p-2 qhd:p-3 rounded-xl lg:rounded-2xl bg-white/85 border border-slate-200/80 shadow-2xs">
              <span data-i18n="card3_q3_title" class="font-bold text-slate-900 text-[10px] sm:text-[11px] qhd:text-xs block leading-snug">Q3. 도입 상담 및 방문 데모</span>
              <p data-i18n="card3_q3_desc" class="text-[8px] sm:text-[9px] qhd:text-[11px] text-slate-600 leading-tight mt-0.5 break-keep">이메일 접수 시 전담팀 1:1 방문 시연</p>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>

</section>

<script>
  // ==============================================================
  // 4-Column Horizontal Bottom Cards Interactive Controller
  // ==============================================================
  let activeCardIndex = 0;
  const cardElements = [
    document.getElementById('hero-card-0'),
    document.getElementById('hero-card-1'),
    document.getElementById('hero-card-2'),
    document.getElementById('hero-card-3')
  ];

  const mobileTabs = [
    document.getElementById('m-tab-0'),
    document.getElementById('m-tab-1'),
    document.getElementById('m-tab-2'),
    document.getElementById('m-tab-3')
  ];

  const headerLinks = document.querySelectorAll('.nav-link');
  const navIdList = ['nav-hero', 'nav-tech', 'nav-clinical', 'nav-faq'];

  function selectHeroCard(index: number) {
    if (index < 0 || index >= cardElements.length) return;
    activeCardIndex = index;

    cardElements.forEach((card, i) => {
      if (!card) return;
      if (i === activeCardIndex) {
        // Active Card: Solid white background, teal accent border & glow ring, visible on all viewports
        card.className = 'hero-bottom-card rounded-2xl lg:rounded-3xl p-3 sm:p-3.5 lg:p-4 qhd:p-6 4k:p-8 flex flex-col justify-between cursor-pointer transition-all duration-300 ease-out bg-white/95 backdrop-blur-xl border-2 border-[#00A396]/60 shadow-lg ring-2 ring-[#00A396]/20 min-h-[225px] sm:min-h-[235px] lg:min-h-[245px] qhd:min-h-[300px] 4k:min-h-[380px] z-20 focus:outline-none focus:ring-4 focus:ring-[#00A396]/40';
        card.setAttribute('aria-selected', 'true');
        card.tabIndex = 0;
      } else {
        // Inactive Card: Hidden on mobile (<md), Frosted glass flex on desktop (>=md), gentle background hover
        card.className = 'hero-bottom-card rounded-2xl lg:rounded-3xl p-3 sm:p-3.5 lg:p-4 qhd:p-6 4k:p-8 hidden md:flex flex-col justify-between cursor-pointer transition-all duration-300 ease-out bg-white/50 hover:bg-white/75 backdrop-blur-md border border-white/60 shadow-xs min-h-[225px] sm:min-h-[235px] lg:min-h-[245px] qhd:min-h-[300px] 4k:min-h-[380px] opacity-90 hover:opacity-100 z-10 focus:outline-none focus:ring-4 focus:ring-[#00A396]/40';
        card.setAttribute('aria-selected', 'false');
      }
    });

    // Update Mobile Quick Tabs
    mobileTabs.forEach((tab, i) => {
      if (!tab) return;
      if (i === activeCardIndex) {
        tab.className = 'flex-1 py-1.5 rounded-xl text-center transition-all bg-[#00A396] text-white font-bold shadow-xs';
      } else {
        tab.className = 'flex-1 py-1.5 rounded-xl text-center transition-all text-slate-600 hover:text-slate-900 font-medium';
      }
    });

    // Update Header Navigation Capsule
    headerLinks.forEach((link) => {
      const targetNavId = navIdList[activeCardIndex];
      const navDot = link.querySelector('.nav-dot');
      if (link.id === targetNavId) {
        link.className = 'nav-link px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-full transition-all duration-300 flex items-center gap-1 sm:gap-1.5 bg-white text-slate-950 font-bold shadow-sm border border-slate-200/80 shrink-0';
        if (navDot) navDot.classList.remove('hidden');
      } else {
        link.className = 'nav-link px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-full transition-all duration-300 flex items-center gap-1 sm:gap-1.5 hover:text-slate-900 text-slate-600 shrink-0';
        if (navDot) navDot.classList.add('hidden');
      }
    });
  }

  // Keyboard navigation for cards
  cardElements.forEach((card, index) => {
    if (!card) return;
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        selectHeroCard(index);
      }
    });
  });

  // Expose to window for global header navigation
  (window as any).selectHeroCard = selectHeroCard;
  (window as any).goToStackCard = selectHeroCard;
  (window as any).switchDashboardTab = (tabKey: string) => {
    const map: Record<string, number> = {
      'tab-dashboard': 0,
      'hero': 0,
      'tab-tech': 1,
      'technology': 1,
      'tab-clinical': 2,
      'clinical': 2,
      'tab-faq': 3,
      'faq': 3
    };
    if (map[tabKey] !== undefined) {
      selectHeroCard(map[tabKey]);
    }
  };

  // Blur-to-Sharp Typography Interaction
  const blurredText = document.getElementById('hero-blurred-text');
  if (blurredText) {
    blurredText.addEventListener('mouseenter', () => {
      blurredText.classList.remove('blur-presbyopia');
      blurredText.classList.add('blur-none');
    });
    blurredText.addEventListener('mouseleave', () => {
      blurredText.classList.remove('blur-none');
      blurredText.classList.add('blur-presbyopia');
    });
  }

  // Background Video Low-Power Mode / Battery Saver Fallback Protection
  const bgVideo = document.getElementById('hero-bg-video') as HTMLVideoElement;
  if (bgVideo) {
    bgVideo.play().catch(() => {
      // If low-power mode blocks autoplay, keep the exact initial video frame at 0.0s
      try {
        bgVideo.currentTime = 0;
      } catch (e) {
        // Ignore seek error
      }
    });
  }

  // Mobile Touch Swipe Gesture Support (01 -> 02 -> 03 -> 04)
  const cardGrid = document.getElementById('hero-card-grid');
  let touchStartX = 0;
  let touchStartY = 0;

  if (cardGrid) {
    cardGrid.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].clientX;
      touchStartY = e.changedTouches[0].clientY;
    }, { passive: true });

    cardGrid.addEventListener('touchend', (e: TouchEvent) => {
      const touchEndX = e.changedTouches[0].clientX;
      const touchEndY = e.changedTouches[0].clientY;
      const diffX = touchEndX - touchStartX;
      const diffY = touchEndY - touchStartY;

      // Trigger swipe if horizontal movement is dominant and moved at least 45px
      if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 45) {
        if (diffX < 0) {
          // Swipe Left -> Next Card
          if (activeCardIndex < cardElements.length - 1) {
            selectHeroCard(activeCardIndex + 1);
          }
        } else {
          // Swipe Right -> Previous Card
          if (activeCardIndex > 0) {
            selectHeroCard(activeCardIndex - 1);
          }
        }
      }
    }, { passive: true });
  }

  // Initialize Card Selection
  selectHeroCard(0);
</script>

<style>
  /* Presbyopia blur simulation effect */
  .blur-presbyopia {
    filter: blur(4px);
    opacity: 0.85;
  }
  .blur-presbyopia:hover, .blur-none {
    filter: blur(0px);
    opacity: 1;
  }

  /* Smooth card state transition on click */
  .hero-bottom-card {
    transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, opacity 0.25s ease;
  }
</style>

