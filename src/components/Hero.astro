---
---

<section id="hero" class="relative min-h-[90vh] lg:min-h-screen pt-20 flex flex-col justify-between bg-[#0A1928] overflow-hidden">
  
  <!-- Ambient Video Background Layer (Full Visibility) -->
  <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none z-0">
    <video
      autoplay
      loop
      muted
      playsinline
      class="w-full h-full object-cover object-center opacity-95 scale-100"
    >
      <source src="/videos/hero-bg.mp4" type="video/mp4" />
    </video>
    
    <!-- Balanced Light Gradient Overlay: Clear Video View with Soft Text Readability -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#F8FAFC]/85 via-[#F8FAFC]/50 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#F8FAFC]/90 via-transparent to-[#F8FAFC]/20"></div>
  </div>

  <!-- Main Clean Light Container -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-12 lg:px-16 flex-1 flex flex-col justify-between pt-16 sm:pt-24 lg:pt-32 pb-16">
    
    <!-- Top / Main Content Block -->
    <div class="max-w-3xl">
      
      <!-- Category Tag -->
      <div class="flex items-center gap-2 mb-8 scroll-reveal">
        <span class="w-5 h-[2px] bg-[#00A396] scroll-line"></span>
        <span class="font-mono text-xs font-bold tracking-[0.25em] text-[#00A396] uppercase drop-shadow-sm">
          노안 AI 진단 & 처방 엔진
        </span>
      </div>

      <!-- Headline (Hero B: Blur to Sharp Typography with Interactive Focus) -->
      <div class="mb-8 select-none">
        <h1 class="text-4xl sm:text-6xl xl:text-7xl font-black text-slate-900 tracking-tight leading-[1.15] mb-2 drop-shadow-sm">
          <!-- Line 1: Blurred text that clarifies on hover -->
          <span id="hero-blurred-text" class="blur-presbyopia inline-block cursor-default transition-all duration-700" title="초점이 흐려진 상태 (마우스를 올리면 선명해집니다)">
            흐려진 글자 앞에서
          </span>
          <br />
          <!-- Line 2: Sharp text -->
          <span class="text-slate-900 inline-block mt-2 scroll-reveal scroll-reveal-delay-1">
            멈추지 않도록.
          </span>
        </h1>
      </div>

      <!-- Description Paragraph -->
      <p class="text-base sm:text-xl text-slate-800 font-medium leading-relaxed max-w-2xl mb-8 scroll-reveal scroll-reveal-delay-2 drop-shadow-sm">
        게이즈인투의 AI는 노안의 진행 단계를 정량 판독하고, 당신의 눈이 실제로 머무는 거리에 맞춰 처방을 설계합니다.
      </p>

      <!-- CTA Buttons (Preserved for trial/inquiries) -->
      <div class="hidden flex-wrap items-center gap-4 mb-16 scroll-reveal scroll-reveal-delay-3" id="hero-cta-buttons">
        <button
          type="button"
          onclick="window.openContactModal('trial')"
          class="px-8 py-4 rounded bg-[#0F2236] hover:bg-[#1A334E] text-white text-sm font-bold tracking-tight shadow-sm transition-all duration-200 hover:-translate-y-0.5"
        >
          30초 자가 진단 시작
        </button>

        <button
          type="button"
          onclick="window.openContactModal('b2b')"
          class="px-8 py-4 rounded bg-white hover:bg-slate-50 text-slate-800 text-sm font-semibold tracking-tight border border-slate-300 shadow-sm transition-all duration-200 hover:-translate-y-0.5"
        >
          안경원·의원 도입 문의
        </button>
      </div>

    </div>

    <!-- Bottom Stats & Validation Bar -->
    <div class="pt-8 border-t border-slate-300/80 backdrop-blur-md bg-white/40 p-4 rounded-xl mt-16 sm:mt-24 scroll-reveal">
      <div class="flex flex-wrap items-center gap-8 sm:gap-14 text-xs sm:text-sm">
        <span class="font-mono text-[11px] sm:text-xs font-bold tracking-widest text-slate-600 uppercase">
          CLINICALLY VALIDATED
        </span>

        <div class="flex items-baseline gap-1.5">
          <strong class="font-extrabold text-slate-950 text-base sm:text-lg font-mono">98.4%</strong>
          <span class="text-slate-700 font-medium">판독 일치율</span>
        </div>

        <div class="flex items-baseline gap-1.5">
          <strong class="font-extrabold text-slate-950 text-base sm:text-lg font-mono">4개</strong>
          <span class="text-slate-700 font-medium">협력 안과</span>
        </div>

        <div class="flex items-baseline gap-1.5">
          <strong class="font-extrabold text-slate-950 text-base sm:text-lg font-mono">12만</strong>
          <span class="text-slate-700 font-medium">학습 데이터</span>
        </div>
      </div>
    </div>

  </div>

</section>
