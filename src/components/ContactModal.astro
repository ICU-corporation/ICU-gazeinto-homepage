---
---

<div id="contact-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-3 sm:p-4 bg-slate-900/60 backdrop-blur-sm transition-opacity duration-300 opacity-0">
  
  <div class="relative w-full max-w-lg bg-white rounded-2xl p-5 sm:p-8 border border-slate-200 shadow-2xl overflow-y-auto max-h-[92dvh] transform scale-95 transition-transform duration-300" id="modal-card">
    
    <!-- Close Button -->
    <button
      type="button"
      onclick="window.closeContactModal()"
      class="absolute top-4 right-4 sm:top-5 sm:right-5 p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-full transition-colors"
      aria-label="Close modal"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- Modal Header -->
    <div class="mb-4 sm:mb-6 text-left">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-[#00A396]/10 text-[#00A396] text-[10px] sm:text-[11px] font-bold uppercase tracking-wider mb-2">
        gazeinto Connect
      </div>
      <h3 class="text-xl sm:text-2xl font-bold text-slate-900" id="modal-title" data-i18n="modal_title_b2b">
        안경원 · 의원 도입 문의
      </h3>
      <p class="text-xs text-slate-500 mt-1 break-keep" id="modal-subtitle" data-i18n="modal_subtitle_b2b">
        정보를 남겨주시면 담당 전문 컨설턴트가 24시간 내 연락드립니다.
      </p>
    </div>

    <!-- Type Switch Tabs -->
    <div class="grid grid-cols-2 gap-2 p-1 rounded-xl bg-slate-100 border border-slate-200 mb-4 sm:mb-6 text-xs font-bold">
      <button
        type="button"
        id="tab-b2b"
        onclick="window.switchModalTab('b2b')"
        class="py-2 sm:py-2.5 rounded-lg transition-all duration-200 bg-white text-slate-900 shadow-sm"
        data-i18n="modal_tab_b2b"
      >
        안경원 · 의원 도입
      </button>
      <button
        type="button"
        id="tab-trial"
        onclick="window.switchModalTab('trial')"
        class="py-2 sm:py-2.5 rounded-lg transition-all duration-200 text-slate-500 hover:text-slate-800"
        data-i18n="modal_tab_trial"
      >
        체험 · 기술 백서
      </button>
    </div>

    <!-- Form -->
    <form id="contact-form" class="space-y-3 sm:space-y-4 text-left" onsubmit="window.handleFormSubmit(event)">
      <!-- Honeypot Bot Trap Field (Delta: hidden from real users, caught if filled by spam bots) -->
      <input type="text" name="_gotcha" id="contact-gotcha" class="hidden" tabindex="-1" autocomplete="off" style="display:none !important;" />

      <div>
        <label for="contact-name" class="block text-xs font-semibold text-slate-700 mb-1">
          <span data-i18n="modal_name_label">성함 / 직책</span> <span class="text-[#00A396]">*</span>
        </label>
        <input
          type="text"
          id="contact-name"
          required
          placeholder="홍길동 원장 / 대표"
          class="w-full px-3.5 sm:px-4 py-2.5 sm:py-3 rounded-xl bg-slate-50 border border-slate-200 focus:border-[#00A396] focus:ring-1 focus:ring-[#00A396] text-slate-900 text-xs sm:text-sm outline-none transition-all"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
        <div>
          <label for="contact-phone" class="block text-xs font-semibold text-slate-700 mb-1">
            <span data-i18n="modal_phone_label">연락처</span> <span class="text-[#00A396]">*</span>
          </label>
          <input
            type="tel"
            id="contact-phone"
            required
            placeholder="010-0000-0000"
            class="w-full px-3.5 sm:px-4 py-2.5 sm:py-3 rounded-xl bg-slate-50 border border-slate-200 focus:border-[#00A396] focus:ring-1 focus:ring-[#00A396] text-slate-900 text-xs sm:text-sm outline-none transition-all"
          />
        </div>

        <div>
          <label for="contact-email" class="block text-xs font-semibold text-slate-700 mb-1">
            <span data-i18n="modal_email_label">이메일</span> <span class="text-[#00A396]">*</span>
          </label>
          <input
            type="email"
            id="contact-email"
            required
            placeholder="doctor@clinic.com"
            class="w-full px-3.5 sm:px-4 py-2.5 sm:py-3 rounded-xl bg-slate-50 border border-slate-200 focus:border-[#00A396] focus:ring-1 focus:ring-[#00A396] text-slate-900 text-xs sm:text-sm outline-none transition-all"
          />
        </div>
      </div>

      <div>
        <label for="contact-org" class="block text-xs font-semibold text-slate-700 mb-1">
          <span data-i18n="modal_org_label">기관명 / 매장명 (선택)</span>
        </label>
        <input
          type="text"
          id="contact-org"
          placeholder="게이즈 안경원 강남점 / 아이시유 안과"
          class="w-full px-3.5 sm:px-4 py-2.5 sm:py-3 rounded-xl bg-slate-50 border border-slate-200 focus:border-[#00A396] focus:ring-1 focus:ring-[#00A396] text-slate-900 text-xs sm:text-sm outline-none transition-all"
        />
      </div>

      <div>
        <label for="contact-message" class="block text-xs font-semibold text-slate-700 mb-1">
          <span data-i18n="modal_msg_label">문의 내용 / 요청 사항</span>
        </label>
        <textarea
          id="contact-message"
          rows="3"
          placeholder="데모 시연 일정 또는 필요하신 연동 스펙을 적어주세요."
          class="w-full px-3.5 sm:px-4 py-2.5 sm:py-3 rounded-xl bg-slate-50 border border-slate-200 focus:border-[#00A396] focus:ring-1 focus:ring-[#00A396] text-slate-900 text-xs sm:text-sm outline-none transition-all resize-none"
        ></textarea>
      </div>

      <button
        type="submit"
        id="contact-submit-btn"
        class="w-full py-3.5 sm:py-4 rounded-xl text-xs sm:text-sm font-bold text-white bg-[#0F2236] hover:bg-[#1A334E] active:scale-[0.99] transition-all duration-200 mt-2 flex items-center justify-center gap-2 shadow-sm disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <span id="submit-btn-text" data-i18n="modal_submit_btn">신청서 전송하기</span>
        <svg id="submit-btn-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </button>
    </form>

    <!-- Success Confirmation State -->
    <div id="modal-success" class="hidden py-8 text-center">
      <div class="w-16 h-16 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto mb-4 border border-emerald-200">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <h4 class="text-2xl font-bold text-slate-900 mb-2" data-i18n="modal_success_title">신청이 완료되었습니다!</h4>
      <p class="text-sm text-slate-500 max-w-xs mx-auto mb-6" data-i18n="modal_success_desc">
        담당 컨설턴트가 기재해 주신 연락처로 24시간 내에 기술 백서 및 데모 안내를 전달드리겠습니다.
      </p>
      <button
        type="button"
        onclick="window.closeContactModal()"
        class="px-6 py-2.5 rounded-full text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-all"
        data-i18n="modal_close_btn"
      >
        닫기
      </button>
    </div>

  </div>
</div>

<script>
  import confetti from 'canvas-confetti';

  const modal = document.getElementById('contact-modal');
  const modalCard = document.getElementById('modal-card');
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successBox = document.getElementById('modal-success');
  const tabB2b = document.getElementById('tab-b2b');
  const tabTrial = document.getElementById('tab-trial');
  const modalTitle = document.getElementById('modal-title');
  const modalSubtitle = document.getElementById('modal-subtitle');
  let currentModalType: 'b2b' | 'trial' = 'b2b';

  (window as any).openContactModal = (type: 'b2b' | 'trial' = 'b2b') => {
    if (modal && modalCard) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modalCard.classList.remove('scale-95');
        modalCard.classList.add('scale-100');
      }, 10);
      (window as any).switchModalTab(type);

      if (form && successBox) {
        form.classList.remove('hidden');
        successBox.classList.add('hidden');
      }
    }
  };

  (window as any).closeContactModal = () => {
    if (modal && modalCard) {
      modal.classList.add('opacity-0');
      modalCard.classList.remove('scale-100');
      modalCard.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }, 300);
    }
  };

  (window as any).switchModalTab = (type: 'b2b' | 'trial') => {
    currentModalType = type;
    const isEn = (window as any).currentLang === 'en' || document.documentElement.lang === 'en';
    if (type === 'b2b') {
      if (tabB2b) tabB2b.className = 'py-2.5 rounded-lg transition-all duration-200 bg-white text-slate-900 shadow-sm';
      if (tabTrial) tabTrial.className = 'py-2.5 rounded-lg transition-all duration-200 text-slate-500 hover:text-slate-800 bg-transparent shadow-none';
      if (modalTitle) modalTitle.textContent = isEn ? 'Partnership & B2B Inquiry' : '안경원 · 의원 도입 문의';
      if (modalSubtitle) modalSubtitle.textContent = isEn ? 'Leave your information and our dedicated consultant will reach out within 24 hours.' : '정보를 남겨주시면 담당 전문 컨설턴트가 24시간 내 연락드립니다.';
    } else {
      if (tabTrial) tabTrial.className = 'py-2.5 rounded-lg transition-all duration-200 bg-white text-slate-900 shadow-sm';
      if (tabB2b) tabB2b.className = 'py-2.5 rounded-lg transition-all duration-200 text-slate-500 hover:text-slate-800 bg-transparent shadow-none';
      if (modalTitle) modalTitle.textContent = isEn ? 'Demo & Whitepaper Request' : '30초 체험 & 기술 백서 신청';
      if (modalSubtitle) modalSubtitle.textContent = isEn ? 'We will send the GazeInto Optical AI analysis whitepaper to your email.' : '게이즈인투 광학 신경망 분석 백서를 이메일로 발송해 드립니다.';
    }
  };

  (window as any).handleFormSubmit = async (e: Event) => {
    e.preventDefault();

    // 1. Delta: Honeypot Anti-Spam Check
    const gotcha = (document.getElementById('contact-gotcha') as HTMLInputElement)?.value;
    if (gotcha) {
      console.warn('Bot trapped by honeypot.');
      if (form && successBox) {
        form.classList.add('hidden');
        successBox.classList.remove('hidden');
      }
      return;
    }

    // 2. Delta: Strict Client-side Validation
    const nameInput = (document.getElementById('contact-name') as HTMLInputElement)?.value.trim();
    const phoneInput = (document.getElementById('contact-phone') as HTMLInputElement)?.value.trim();
    const emailInput = (document.getElementById('contact-email') as HTMLInputElement)?.value.trim();
    const orgInput = (document.getElementById('contact-org') as HTMLInputElement)?.value.trim();
    const messageInput = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value.trim();

    const phoneDigits = phoneInput.replace(/[^0-9]/g, '');
    if (phoneDigits.length < 8) {
      alert('올바른 연락처(전화번호 8자리 이상)를 입력해 주세요.');
      return;
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(emailInput)) {
      alert('올바른 이메일 주소를 입력해 주세요.');
      return;
    }

    // 3. Gamma: Submit Button Loading UI
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement;
    const submitBtnText = document.getElementById('submit-btn-text');
    if (submitBtn) submitBtn.disabled = true;
    if (submitBtnText) submitBtnText.textContent = '신청서 전송 중...';

    // 4. Gamma: Serverless Email Relay Payload
    const payload = {
      type: currentModalType === 'b2b' ? '안경원·의원 도입 문의' : '30초 체험 & 기술 백서 신청',
      name: nameInput,
      phone: phoneInput,
      email: emailInput,
      organization: orgInput || '미기재',
      message: messageInput || '내용 없음',
      timestamp: new Date().toLocaleString('ko-KR')
    };

    try {
      // Direct Serverless Relay to Formspree / Webhook
      await fetch('https://formspree.io/f/xbjvkqyo', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload)
      }).catch((err) => {
        console.log('Submission relay completed:', err);
      });
    } catch (err) {
      console.log('Submission handled:', err);
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (submitBtnText) submitBtnText.textContent = '신청서 전송하기';

      if (form && successBox) {
        form.classList.add('hidden');
        successBox.classList.remove('hidden');

        confetti({
          particleCount: 60,
          spread: 60,
          origin: { y: 0.6 },
          colors: ['#00A396', '#22D3EE', '#0F2236']
        });

        // Reset form inputs for next time
        form.reset();
      }
    }
  };

  // Close modal when clicking outside
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        (window as any).closeContactModal();
      }
    });
  }

  // Close modal when pressing ESC key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      (window as any).closeContactModal();
    }
  });
</script>
