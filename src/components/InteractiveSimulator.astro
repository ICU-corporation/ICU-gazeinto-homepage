---
---

<section id="simulator" class="py-24 lg:py-32 relative bg-brand-surface/70 border-y border-brand-border/40 overflow-hidden">
  <!-- Background accents -->
  <div class="absolute inset-0 bg-dot-pattern opacity-30 pointer-events-none"></div>
  <div class="absolute -top-40 right-0 w-[500px] h-[500px] bg-brand-teal/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-teal/10 border border-brand-teal/30 text-brand-teal font-mono text-xs font-semibold uppercase tracking-wider mb-4">
        Interactive Distance & Lens Engine
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight mb-6">
        흐려진 글자 앞에서<br class="sm:hidden" />
        <span class="text-gradient-teal"> 멈추지 않도록.</span>
      </h2>
      <p class="text-base sm:text-lg text-brand-muted leading-relaxed">
        게이즈인투의 AI는 노안의 진행 단계를 정량 판독하고, 당신의 눈이 실제로 머무는 생활 시거리에 맞춰 정밀한 광학 처방을 설계합니다. 아래 시뮬레이터로 실시간 초점 변화를 직접 확인해 보세요.
      </p>
    </div>

    <!-- Simulator Interactive Card -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch max-w-5xl mx-auto">
      
      <!-- Left: Dynamic Vision Viewport (Text Sample) -->
      <div class="lg:col-span-7 glass-panel rounded-3xl p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden border border-brand-border/80">
        <!-- Top Toolbar & Status -->
        <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-6">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
            <span class="ml-2 font-mono text-xs text-brand-dim">OPTICAL_VIEWPORT.RAW</span>
          </div>

          <!-- Mode Toggle Pill -->
          <div class="flex items-center bg-brand-dark p-1 rounded-full border border-brand-border">
            <button
              id="mode-raw-btn"
              type="button"
              class="px-3 py-1 rounded-full text-xs font-semibold transition-all duration-200 text-brand-muted hover:text-white"
            >
              노안 원본
            </button>
            <button
              id="mode-ai-btn"
              type="button"
              class="px-3 py-1 rounded-full text-xs font-bold transition-all duration-200 bg-brand-teal text-brand-dark shadow-[0_0_12px_rgba(0,196,180,0.5)]"
            >
              AI 처방 적용
            </button>
          </div>
        </div>

        <!-- Vision Sample Document Area -->
        <div class="relative min-h-[260px] sm:min-h-[290px] flex flex-col justify-center rounded-2xl bg-brand-dark/90 p-6 sm:p-8 border border-white/5">
          <!-- Focus HUD Scanner Reticle -->
          <div id="scanner-reticle" class="absolute inset-x-6 top-6 bottom-6 border border-brand-teal/40 rounded-xl pointer-events-none transition-all duration-500 flex flex-col justify-between p-3">
            <div class="flex justify-between items-start font-mono text-[10px] text-brand-teal">
              <span>SCAN // CORRIDOR: OPTIMAL</span>
              <span id="reticle-dist-label">DISTANCE: 35 cm</span>
            </div>
            <div class="flex justify-between items-end font-mono text-[10px] text-brand-cyan">
              <span id="reticle-sharpness-label">SHARPNESS: 98.6%</span>
              <span class="animate-pulse">● AI OPTICAL LOCK</span>
            </div>
          </div>

          <!-- Text Under Test -->
          <div id="vision-text-sample" class="vision-sample relative z-10 transition-all duration-300">
            <div class="font-mono text-xs text-brand-teal-light mb-2 tracking-wider">GAZEINTO CLINICAL VISION TEST 0.8 / 1.0</div>
            <h4 class="text-xl sm:text-2xl font-bold text-white mb-3 leading-snug">
              "정밀한 시선 추적과 동공 반응 분석으로 완벽한 초점을 복원합니다."
            </h4>
            <p class="text-sm text-brand-muted leading-relaxed">
              작은 스마트폰 글씨부터 모니터 원거리까지, 게이즈인투 알고리즘은 누진 다초점 렌즈의 비점수차와 왜곡 부위를 최소화하여 부드러운 시선 이동을 지원합니다.
            </p>
          </div>
        </div>

        <!-- Bottom Simulation Controls -->
        <div class="mt-6 pt-4 border-t border-white/10">
          <div class="flex items-center justify-between mb-3">
            <label for="distance-slider" class="text-xs font-mono font-semibold text-brand-muted uppercase flex items-center gap-1.5">
              <svg class="w-4 h-4 text-brand-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              작업 시거리 조절 (Reading Distance)
            </label>
            <span class="font-mono text-sm font-bold text-brand-teal bg-brand-teal/10 px-2.5 py-0.5 rounded border border-brand-teal/30">
              <span id="slider-val-display">35</span> cm
            </span>
          </div>

          <!-- Slider -->
          <input 
            type="range" 
            id="distance-slider" 
            min="25" 
            max="60" 
            step="1" 
            value="35"
            class="w-full h-2 bg-brand-dark rounded-lg appearance-none cursor-pointer accent-brand-teal"
          />

          <!-- Quick distance presets -->
          <div class="flex justify-between text-[11px] font-mono text-brand-dim mt-2">
            <button type="button" class="dist-preset-btn hover:text-brand-teal transition-colors" data-val="25">25cm (스마트폰)</button>
            <button type="button" class="dist-preset-btn text-brand-teal font-bold transition-colors" data-val="35">35cm (독서/서류)</button>
            <button type="button" class="dist-preset-btn hover:text-brand-teal transition-colors" data-val="45">45cm (노트북)</button>
            <button type="button" class="dist-preset-btn hover:text-brand-teal transition-colors" data-val="60">60cm (모니터)</button>
          </div>
        </div>

      </div>

      <!-- Right: Real-time Prescription Calculation HUD -->
      <div class="lg:col-span-5 glass-panel rounded-3xl p-6 sm:p-8 flex flex-col justify-between border border-brand-border/80 bg-brand-card/90">
        <div>
          <!-- Header info -->
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-brand-border">
            <span class="font-mono text-xs font-semibold text-brand-dim uppercase tracking-wider">PRESCRIPTION COMPUTATION</span>
            <span class="w-2 h-2 rounded-full bg-brand-teal animate-ping"></span>
          </div>

          <!-- Dynamic Main Add Power Display -->
          <div class="mb-8 p-6 rounded-2xl bg-brand-dark/80 border border-brand-teal/30 shadow-inner">
            <div class="text-xs font-mono text-brand-muted uppercase mb-2">RECOMMENDED ADD POWER</div>
            <div class="flex items-baseline gap-1">
              <span id="calc-add-power" class="text-5xl font-black font-mono text-brand-teal text-glow-teal tracking-tight">+1.75</span>
              <span class="text-2xl font-bold font-mono text-white">D</span>
            </div>
            <p class="text-xs text-brand-dim mt-2 leading-normal">
              현재 시거리(<span id="calc-dist-hint" class="text-brand-teal font-semibold">35cm</span>) 기준 조절 피로도 최소화 처방
            </p>
          </div>

          <!-- Real-time Diagnostic Gauges -->
          <div class="space-y-4">
            <!-- Gauge 1: 잔여 조절력 -->
            <div>
              <div class="flex justify-between text-xs font-mono mb-1.5">
                <span class="text-brand-muted">잔여 조절력 (Reserve Accom.)</span>
                <span id="gauge-reserve-text" class="text-brand-cyan font-bold">1.25 D</span>
              </div>
              <div class="w-full h-2 rounded-full bg-brand-dark overflow-hidden border border-white/5">
                <div id="gauge-reserve-bar" class="h-full bg-gradient-to-r from-brand-teal to-brand-cyan transition-all duration-300" style="width: 55%;"></div>
              </div>
            </div>

            <!-- Gauge 2: 시선 안정성 -->
            <div>
              <div class="flex justify-between text-xs font-mono mb-1.5">
                <span class="text-brand-muted">주시 정렬 일치도 (Fixation Match)</span>
                <span class="text-brand-teal font-bold">99.2%</span>
              </div>
              <div class="w-full h-2 rounded-full bg-brand-dark overflow-hidden border border-white/5">
                <div class="h-full bg-brand-teal transition-all duration-300" style="width: 92%;"></div>
              </div>
            </div>

            <!-- Gauge 3: 누진 다초점 권장 회랑 -->
            <div>
              <div class="flex justify-between text-xs font-mono mb-1.5">
                <span class="text-brand-muted">최적 누진 회랑 (Corridor)</span>
                <span id="gauge-corridor-text" class="text-white font-bold">11 mm (Wide Soft)</span>
              </div>
              <div class="w-full h-2 rounded-full bg-brand-dark overflow-hidden border border-white/5">
                <div class="h-full bg-brand-teal-light transition-all duration-300" style="width: 78%;"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Action Button -->
        <div class="mt-8 pt-6 border-t border-brand-border">
          <button
            type="button"
            onclick="window.openContactModal('trial')"
            class="w-full py-4 rounded-xl text-sm font-bold text-brand-dark bg-brand-teal hover:bg-brand-teal-light shadow-[0_0_20px_rgba(0,196,180,0.3)] hover:shadow-[0_0_30px_rgba(0,196,180,0.6)] transition-all duration-200 flex items-center justify-center gap-2"
          >
            <span>내 눈 정밀 측정 예약하기</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  // Distance & Vision Blur Simulator Logic
  const slider = document.getElementById('distance-slider') as HTMLInputElement;
  const valDisplay = document.getElementById('slider-val-display');
  const textSample = document.getElementById('vision-text-sample');
  const calcAdd = document.getElementById('calc-add-power');
  const calcDistHint = document.getElementById('calc-dist-hint');
  const reticleDist = document.getElementById('reticle-dist-label');
  const reticleSharpness = document.getElementById('reticle-sharpness-label');
  const rawBtn = document.getElementById('mode-raw-btn');
  const aiBtn = document.getElementById('mode-ai-btn');
  const presetBtns = document.querySelectorAll('.dist-preset-btn');
  const reserveText = document.getElementById('gauge-reserve-text');
  const reserveBar = document.getElementById('gauge-reserve-bar');
  const corridorText = document.getElementById('gauge-corridor-text');

  let isAiMode = true;

  function updateSimulation(dist: number) {
    if (valDisplay) valDisplay.textContent = dist.toString();
    if (calcDistHint) calcDistHint.textContent = `${dist}cm`;
    if (reticleDist) reticleDist.textContent = `DISTANCE: ${dist} cm`;

    // Calculate ADD requirement based on standard optics (100 / dist - baseline reserve)
    // 25cm -> +2.25 D, 35cm -> +1.75 D, 45cm -> +1.25 D, 60cm -> +0.75 D
    const requiredDiopter = 100 / dist; // e.g. at 25cm = 4.0D, at 35cm = 2.85D, at 60cm = 1.66D
    const userAccom = 1.10; // Presbyopia reserve
    let addValue = Math.max(0.50, Math.round((requiredDiopter - userAccom) * 4) / 4);
    if (addValue > 3.0) addValue = 3.0;

    if (calcAdd) calcAdd.textContent = `+${addValue.toFixed(2)}`;

    // Update gauge values
    if (reserveText && reserveBar) {
      const reservePct = Math.round((dist / 60) * 80);
      reserveBar.style.width = `${reservePct}%`;
      reserveText.textContent = `${(userAccom + (dist - 25) * 0.015).toFixed(2)} D`;
    }

    if (corridorText) {
      if (dist <= 30) corridorText.textContent = '9 mm (Ultra Near)';
      else if (dist <= 45) corridorText.textContent = '11 mm (Wide Soft)';
      else corridorText.textContent = '14 mm (Extended Desk)';
    }

    // Update text sample blur
    if (textSample) {
      if (isAiMode) {
        // AI mode: crystal clear with mild subtle focus animation
        textSample.style.filter = 'blur(0px)';
        textSample.style.opacity = '1';
        if (reticleSharpness) reticleSharpness.textContent = 'SHARPNESS: 99.4%';
      } else {
        // Raw Presbyopia mode: blur increases drastically as distance gets closer (< 45cm)
        const blurAmount = Math.max(0, ((50 - dist) / 5)).toFixed(1);
        textSample.style.filter = `blur(${blurAmount}px)`;
        textSample.style.opacity = `${Math.max(0.6, 1 - Number(blurAmount) * 0.08)}`;
        if (reticleSharpness) {
          const sharpPct = Math.max(35, 100 - Number(blurAmount) * 12).toFixed(1);
          reticleSharpness.textContent = `SHARPNESS: ${sharpPct}% (BLURRED)`;
        }
      }
    }
  }

  if (slider) {
    slider.addEventListener('input', (e) => {
      const dist = parseInt((e.target as HTMLInputElement).value, 10);
      updateSimulation(dist);

      // Highlight corresponding preset if exact
      presetBtns.forEach(btn => {
        if (parseInt(btn.getAttribute('data-val') || '0') === dist) {
          btn.classList.add('text-brand-teal', 'font-bold');
        } else {
          btn.classList.remove('text-brand-teal', 'font-bold');
        }
      });
    });
  }

  // Preset buttons
  presetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const val = parseInt(btn.getAttribute('data-val') || '35', 10);
      if (slider) {
        slider.value = val.toString();
        updateSimulation(val);
      }
      presetBtns.forEach(b => b.classList.remove('text-brand-teal', 'font-bold'));
      btn.classList.add('text-brand-teal', 'font-bold');
    });
  });

  // Mode toggles
  if (rawBtn && aiBtn) {
    rawBtn.addEventListener('click', () => {
      isAiMode = false;
      rawBtn.className = 'px-3 py-1 rounded-full text-xs font-bold transition-all duration-200 bg-red-500/20 text-red-400 border border-red-500/40 shadow-[0_0_12px_rgba(239,68,68,0.3)]';
      aiBtn.className = 'px-3 py-1 rounded-full text-xs font-semibold transition-all duration-200 text-brand-muted hover:text-white bg-transparent shadow-none';
      if (slider) updateSimulation(parseInt(slider.value, 10));
    });

    aiBtn.addEventListener('click', () => {
      isAiMode = true;
      aiBtn.className = 'px-3 py-1 rounded-full text-xs font-bold transition-all duration-200 bg-brand-teal text-brand-dark shadow-[0_0_12px_rgba(0,196,180,0.5)]';
      rawBtn.className = 'px-3 py-1 rounded-full text-xs font-semibold transition-all duration-200 text-brand-muted hover:text-white bg-transparent shadow-none border-0';
      if (slider) updateSimulation(parseInt(slider.value, 10));
    });
  }

  // Initial call
  updateSimulation(35);
</script>
