---
import { translations, type Language } from '../i18n/translations';

interface Props {
  lang?: Language;
}

const { lang = 'ko' } = Astro.props;
const t = translations[lang] || translations.ko;
---

<footer class="bg-[#081726] border-t border-slate-800 py-16 text-slate-400 text-xs">
  <div class="max-w-7xl xl:max-w-[1570px] 2xl:max-w-[1630px] qhd:max-w-[2050px] 4k:max-w-[2750px] mx-auto px-4 sm:px-6 lg:px-8 xl:px-10">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-12 border-b border-slate-800">
      
      <!-- Brand column -->
      <div class="md:col-span-6">
        <a href="#hero" class="flex items-center gap-3 mb-4 group inline-flex">
          <div class="relative w-7 h-7 flex items-center justify-center">
            <div class="absolute w-5 h-5 rounded-full border-2 border-white -left-0.5"></div>
            <div class="absolute w-5 h-5 rounded-full border-2 border-white -right-0.5"></div>
            <div class="absolute w-2.5 h-4 bg-[#00A396] rounded-full"></div>
          </div>
          <span class="text-2xl font-extrabold tracking-tight text-white">gazeinto</span>
        </a>

        <p class="text-xs text-slate-400 leading-relaxed max-w-sm mb-6 break-keep">
          <strong data-i18n="footer_tagline">{t.footer_tagline}</strong><br />
          <span data-i18n="footer_desc">{t.footer_desc}</span>
        </p>

        <div class="flex items-center gap-3 text-slate-400 text-[11px] font-semibold">
          <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-[#00C4B4]">
            XR FUNDUS CAMERA
          </span>
          <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-[#22D3EE]">
            BUILT-IN RETINAL AI
          </span>
        </div>
      </div>

      <!-- Nav links -->
      <div class="md:col-span-3">
        <h4 data-i18n="footer_col1_title" class="text-white font-bold text-sm mb-4">{t.footer_col1_title}</h4>
        <ul class="space-y-2.5">
          <li><a href="#hero" onclick="if(window.switchDashboardTab) window.switchDashboardTab('tab-dashboard');" data-i18n="footer_link1" class="hover:text-[#00C4B4] transition-colors">{t.footer_link1}</a></li>
          <li><a href="#hero" onclick="if(window.switchDashboardTab) window.switchDashboardTab('tab-tech');" data-i18n="footer_link2" class="hover:text-[#00C4B4] transition-colors">{t.footer_link2}</a></li>
          <li><a href="#hero" onclick="if(window.switchDashboardTab) window.switchDashboardTab('tab-clinical');" data-i18n="footer_link3" class="hover:text-[#00C4B4] transition-colors">{t.footer_link3}</a></li>
          <li><a href="#hero" onclick="if(window.switchDashboardTab) window.switchDashboardTab('tab-faq');" data-i18n="footer_link4" class="hover:text-[#00C4B4] transition-colors">{t.footer_link4}</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="md:col-span-3">
        <h4 class="text-white font-bold text-sm mb-4">Contact & Inquiries</h4>
        <div class="space-y-2.5 text-slate-400 leading-relaxed text-xs">
          <p data-i18n="footer_company_title" class="text-white font-bold text-sm">{t.footer_company_title}</p>
          <p class="flex items-center gap-2">
            <span class="text-slate-500">Website:</span>
            <a href="https://www.gazeinto.kr" target="_blank" class="text-[#00C4B4] hover:underline">www.gazeinto.kr</a>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-slate-500">Email:</span>
            <a href="mailto:gazeinto1nc@gmail.com" class="text-[#00C4B4] hover:underline font-semibold">gazeinto1nc@gmail.com</a>
          </p>
          <p class="text-[11px] text-slate-500 pt-2 leading-normal break-keep">Mixed reality fundus camera with AI screening for age-related eye diseases.</p>
        </div>
      </div>

    </div>

    <!-- Bottom Disclaimer & Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-slate-500 text-[11px]">
      <p>
        © 2026 GazeInto Inc. All rights reserved. | www.gazeinto.kr
      </p>
      <div class="flex gap-6">
        <a href="#" data-i18n="footer_terms" class="hover:text-white transition-colors">{t.footer_terms}</a>
        <a href="#" data-i18n="footer_privacy" class="hover:text-white transition-colors">{t.footer_privacy}</a>
      </div>
    </div>

  </div>
</footer>
