---
const faqs = [
  {
    q: "GazeInto의 XR 안저 카메라(Fundus Camera)는 어떤 기기인가요?",
    a: "GazeInto는 사용자가 직접 착용(Self-operated)하여 시선 유도(Gaze Guidance) 기술을 통해 스스로 망막 안저 이미지를 촬영하고, 온디바이스 AI로 3대 노인성 실명 안질환(황반변성, 녹내장, 당뇨망막병증) 및 노안 진행도를 조기 스크리닝하는 세계 최초 수준의 Mixed Reality 일체형 안저 검사 디바이스입니다."
  },
  {
    q: "전문 의료 인력 없이 비숙련자나 어르신도 혼자서 촬영할 수 있나요?",
    a: "네. 기존 안저 카메라는 숙련된 검사자가 동공의 위치를 맞추고 촬영해야 했으나, GazeInto는 XR 헤드셋 내부의 지능형 시선 유도 인터랙션이 사용자의 주시 방향을 자동으로 가이드하여 조작자 없이(Operator-free) 누구나 간편하게 표준화된 고화질 안저 이미지를 캡처할 수 있습니다."
  },
  {
    q: "재택(At-home) 환경 및 의료 취약지에서도 사용할 수 있나요?",
    a: "그렇습니다. 거대 암실 장비(Tabletop)나 병원 방문이 필요 없는 컴팩트 헤드셋 일체형 구조이므로, 가정 내 자가 모니터링은 물론 요양시설, 이동 검진, 보건지소 등 의료 접근성이 낮은 환경에서도 연속적인 안건강 관리를 지원합니다."
  },
  {
    q: "병원 및 검안 센터와의 제휴 및 기기 도입 절차는 어떻게 되나요?",
    a: "우측 상단의 '도입 문의' 또는 공식 이메일(gazeinto1nc@gmail.com)을 통해 문의해 주시면, 전문 상담팀이 기기 데모 시연 및 임상 연동 가이드를 신속하게 안내해 드립니다."
  }
];
---

<section id="faq" class="py-24 sm:py-36 bg-white border-t border-slate-200">
  <div class="max-w-4xl mx-auto px-6 sm:px-12">
    
    <div class="max-w-2xl mb-14 scroll-reveal">
      <div class="flex items-center gap-2.5 mb-3">
        <span class="w-6 h-[2px] bg-[#00A396] scroll-line"></span>
        <span class="font-mono text-xs font-bold tracking-widest text-[#00A396] uppercase">
          CHAPTER 03 / FREQUENTLY ASKED QUESTIONS
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        자주 묻는 질문
      </h2>
    </div>

    <!-- Accordion -->
    <div class="space-y-4">
      {faqs.map((faq) => (
        <div class="rounded-xl border border-slate-200 bg-[#F8FAFC] overflow-hidden">
          <button
            type="button"
            class="faq-toggle-btn w-full p-6 text-left flex items-center justify-between gap-4 hover:text-[#00A396] transition-colors"
          >
            <span class="text-base font-bold text-slate-900 flex items-center gap-3">
              <span class="text-[#00A396] font-mono text-sm">Q.</span>
              {faq.q}
            </span>
            <svg class="faq-icon w-5 h-5 text-slate-400 transition-transform duration-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="faq-content hidden px-6 pb-6 text-sm text-slate-600 leading-relaxed border-t border-slate-200/60 pt-4">
            {faq.a}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  document.querySelectorAll('.faq-toggle-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const content = btn.nextElementSibling as HTMLElement;
      const icon = btn.querySelector('.faq-icon') as HTMLElement;
      const isHidden = content.classList.contains('hidden');

      document.querySelectorAll('.faq-content').forEach(c => c.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => (i as HTMLElement).style.transform = 'rotate(0deg)');

      if (isHidden) {
        content.classList.remove('hidden');
        if (icon) icon.style.transform = 'rotate(180deg)';
      }
    });
  });
</script>
