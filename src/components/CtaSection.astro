---
---

<section class="py-24 relative overflow-hidden">
  <!-- Background radial glow -->
  <div class="absolute inset-0 bg-radial-lens opacity-70 pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    
    <div class="glass-panel rounded-3xl p-10 sm:p-16 border border-brand-teal/40 relative overflow-hidden shadow-[0_0_80px_rgba(0,196,180,0.15)]">
      <!-- Glow background decoration -->
      <div class="absolute -top-32 -left-32 w-64 h-64 bg-brand-teal/20 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-32 -right-32 w-64 h-64 bg-brand-cyan/20 rounded-full blur-3xl"></div>

      <!-- Content -->
      <div class="relative z-10 max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-dark/90 border border-brand-teal/30 text-brand-teal font-mono text-xs font-semibold uppercase tracking-wider mb-6">
          Ready to Transform Presbyopia Diagnostics?
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight mb-6">
          더 선명한 일상을 위한<br />
          <span class="text-gradient-teal">AI 광학 파트너십을 시작하세요.</span>
        </h2>

        <p class="text-base sm:text-lg text-brand-muted leading-relaxed mb-10 max-w-2xl mx-auto">
          지금 안경원 및 안과 클리닉 파트너십을 신청하시면, 2주간의 무료 라이선스와 온보딩 컨설팅을 지원해 드립니다.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <button
            type="button"
            onclick="window.openContactModal('b2b')"
            class="px-8 py-4 rounded-full text-base font-bold text-brand-dark bg-brand-teal hover:bg-brand-teal-light shadow-[0_0_30px_rgba(0,196,180,0.5)] hover:shadow-[0_0_45px_rgba(0,196,180,0.8)] transform hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2"
          >
            <span>도입 파트너십 신청하기</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>

          <button
            type="button"
            onclick="window.openContactModal('trial')"
            class="px-7 py-4 rounded-full text-base font-semibold text-white bg-brand-dark hover:bg-brand-card border border-brand-border hover:border-brand-teal/50 transition-all duration-200"
          >
            기술 백서 다운로드
          </button>
        </div>
      </div>
    </div>

  </div>
</section>
