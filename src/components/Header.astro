---
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#F8FAFC]/90 backdrop-blur-md transition-all duration-300 border-b border-slate-200/60" id="main-header">
  <!-- Top Scroll Progress Bar -->
  <div id="scroll-progress" class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-[#00A396] via-[#22D3EE] to-[#00C4B4] z-50"></div>

  <div class="max-w-[1920px] mx-auto px-6 sm:px-12 lg:px-16 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="#hero" onclick="if(window.switchDashboardTab) window.switchDashboardTab('tab-dashboard');" class="flex items-center gap-3 group">
      <!-- Focal Lens Logo Symbol -->
      <div class="relative w-8 h-8 flex items-center justify-center">
        <div class="absolute w-6 h-6 rounded-full border-2 border-slate-900 -left-0.5 group-hover:scale-105 transition-transform duration-300"></div>
        <div class="absolute w-6 h-6 rounded-full border-2 border-slate-900 -right-0.5 group-hover:scale-105 transition-transform duration-300"></div>
        <div class="absolute w-3 h-5 bg-[#00A396] rounded-full opacity-95 group-hover:bg-[#00C4B4] transition-colors"></div>
      </div>
      <span class="text-2xl font-extrabold tracking-tight text-slate-900 font-display">gazeinto</span>
    </a>

    <!-- Navigation Menu with Tab & Scroll Synchronization -->
    <nav class="flex items-center gap-1.5 sm:gap-2 p-1 rounded-full bg-slate-200/40 border border-slate-200/60 text-xs sm:text-sm font-medium text-slate-600" id="header-nav">
      <a 
        href="#hero" 
        id="nav-hero"
        onclick="if(window.switchDashboardTab) window.switchDashboardTab('tab-dashboard');"
        class="nav-link px-3 sm:px-3.5 py-1.5 rounded-full transition-all duration-300 flex items-center gap-1.5 bg-white text-slate-950 font-bold shadow-sm border border-slate-200/80"
      >
        <span class="nav-dot w-1.5 h-1.5 rounded-full bg-[#00A396]"></span>
        <span>01 대시보드</span>
      </a>

      <a 
        href="#hero" 
        id="nav-tech"
        onclick="if(window.switchDashboardTab) window.switchDashboardTab('tab-tech');"
        class="nav-link px-3 sm:px-3.5 py-1.5 rounded-full transition-all duration-300 flex items-center gap-1.5 hover:text-slate-900 text-slate-600"
      >
        <span class="nav-dot w-1.5 h-1.5 rounded-full bg-[#00A396] hidden"></span>
        <span>02 기술</span>
      </a>

      <a 
        href="#hero" 
        id="nav-clinical"
        onclick="if(window.switchDashboardTab) window.switchDashboardTab('tab-clinical');"
        class="nav-link px-3 sm:px-3.5 py-1.5 rounded-full transition-all duration-300 flex items-center gap-1.5 hover:text-slate-900 text-slate-600"
      >
        <span class="nav-dot w-1.5 h-1.5 rounded-full bg-[#00A396] hidden"></span>
        <span>03 임상 근거</span>
      </a>

      <a 
        href="#hero" 
        id="nav-faq"
        onclick="if(window.switchDashboardTab) window.switchDashboardTab('tab-faq');"
        class="nav-link px-3 sm:px-3.5 py-1.5 rounded-full transition-all duration-300 flex items-center gap-1.5 hover:text-slate-900 text-slate-600"
      >
        <span class="nav-dot w-1.5 h-1.5 rounded-full bg-[#00A396] hidden"></span>
        <span>04 FAQ</span>
      </a>
    </nav>

    <!-- Right Contact Button -->
    <button 
      type="button"
      onclick="window.openContactModal('b2b')"
      class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-bold text-white bg-[#0F2236] hover:bg-[#1A334E] transition-all shadow-sm"
    >
      <span>도입 문의</span>
      <svg class="w-3.5 h-3.5 text-[#00C4B4]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
      </svg>
    </button>
  </div>
</header>

<script>
  // Global Scroll Progress Tracker
  const progressBar = document.getElementById('scroll-progress');
  window.addEventListener('scroll', () => {
    if (progressBar) {
      const winScroll = document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) : 0;
      progressBar.style.transform = `scaleX(${scrolled})`;
    }
  }, { passive: true });
</script>
