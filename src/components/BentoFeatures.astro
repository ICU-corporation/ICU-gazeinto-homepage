---
---

<section id="technology" class="py-24 sm:py-36 bg-white border-t border-slate-200 relative">
  <div class="max-w-7xl mx-auto px-6 sm:px-12 lg:px-16">
    
    <!-- 3-Step Sticky Chapter Experience (designxhand style: Title + Progress Sticky on Left) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start mb-24">
      
      <!-- Sticky Left Column (Title, Description & Workflow Progress pinned together) -->
      <div class="lg:col-span-5 sticky top-28 space-y-8 scroll-reveal">
        
        <!-- Section Header -->
        <div>
          <div class="flex items-center gap-2.5 mb-4">
            <span class="w-6 h-[2px] bg-[#00A396] scroll-line"></span>
            <span class="font-mono text-xs font-bold tracking-widest text-[#00A396] uppercase">
              CHAPTER 01 / TECHNOLOGY & WORKFLOW
            </span>
          </div>
          <h2 class="text-3xl sm:text-4xl xl:text-5xl font-black text-slate-900 tracking-tight leading-[1.15] mb-6">
            헤드셋 착용부터<br />
            AI 정밀 판독까지,<br />
            <span class="text-[#00A396]">3단계 원스톱 자가 스크리닝</span>
          </h2>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            GazeInto의 XR 일체형 안저 카메라는 병원 방문 없이 집에서 시선 유도(Gaze Guidance) 기술을 통해 스스로 고화질 망막 안저를 촬영하고 AI 분석을 완료합니다.
          </p>
        </div>

        <!-- Workflow Progress Box -->
        <div class="p-6 rounded-2xl bg-[#F8FAFC] border border-slate-200 space-y-4">
          <span class="font-mono text-[11px] font-bold text-slate-400 uppercase tracking-widest block">
            WORKFLOW PROGRESS
          </span>
          <div class="space-y-3 font-mono text-xs sm:text-sm">
            <div id="step-nav-1" class="flex items-center gap-3 text-[#00A396] font-bold transition-all duration-300">
              <span class="w-2 h-2 rounded-full bg-[#00A396]"></span>
              <span>01. WEAR (자가 착용)</span>
            </div>
            <div id="step-nav-2" class="flex items-center gap-3 text-slate-400 font-medium transition-all duration-300">
              <span class="w-2 h-2 rounded-full bg-slate-300"></span>
              <span>02. CAPTURE (시선 유도 촬영)</span>
            </div>
            <div id="step-nav-3" class="flex items-center gap-3 text-slate-400 font-medium transition-all duration-300">
              <span class="w-2 h-2 rounded-full bg-slate-300"></span>
              <span>03. SCREEN (AI 안질환 판독)</span>
            </div>
          </div>
        </div>

        <!-- Mini Info Badge -->
        <div class="p-5 rounded-2xl bg-[#081726] text-white">
          <div class="font-mono text-[10px] text-[#22D3EE] mb-1 uppercase tracking-wider font-bold">ALL-IN-ONE XR</div>
          <div class="text-xs sm:text-sm font-semibold text-slate-200 leading-snug">
            검사자 없이 단 30초 내에 안저 촬영과 AI 분석이 즉시 완료됩니다.
          </div>
        </div>

      </div>

      <!-- Right Step Cards Column (Scrolls smoothly past the sticky left side) -->
      <div class="lg:col-span-7 space-y-8 pt-2 lg:pt-0">
        
        <!-- Step 1: Wear -->
        <div id="step-card-1" class="chapter-card p-8 sm:p-10 rounded-3xl bg-[#F8FAFC] border border-slate-200 scroll-reveal relative overflow-hidden group">
          <div class="flex items-center justify-between mb-6">
            <span class="font-mono text-3xl font-black text-[#00A396]">01</span>
            <div class="flex items-center gap-3">
              <!-- XR Headset Visual Icon Badge -->
              <div class="w-9 h-9 rounded-xl bg-slate-200/70 flex items-center justify-center text-slate-700">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 11h18v6a3 3 0 01-3 3H6a3 3 0 01-3-3v-6z"/>
                  <path d="M3 11V9a4 4 0 014-4h10a4 4 0 014 4v2"/>
                  <circle cx="8" cy="14" r="2"/>
                  <circle cx="16" cy="14" r="2"/>
                </svg>
              </div>
              <span class="font-mono text-xs font-bold tracking-wider px-3 py-1 rounded-full bg-[#00A396]/10 text-[#00A396] border border-[#00A396]/20">
                WEAR
              </span>
            </div>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-4">
            자가 착용 (Self-operated Wear)
          </h3>
          <p class="text-slate-600 text-base leading-relaxed">
            전문 검사자나 복잡한 임상 시설 방문 없이, 집이나 일상 공간에서 가볍게 XR 헤드셋을 착용합니다. 거동이 불편한 고령자도 직관적으로 즉시 시작할 수 있습니다.
          </p>
        </div>

        <!-- Step 2: Capture -->
        <div id="step-card-2" class="chapter-card p-8 sm:p-10 rounded-3xl bg-[#F8FAFC] border border-slate-200 scroll-reveal relative overflow-hidden group">
          <div class="flex items-center justify-between mb-6">
            <span class="font-mono text-3xl font-black text-[#00A396]">02</span>
            <div class="flex items-center gap-3">
              <!-- Fundus Gaze Guidance Optical Icon Badge -->
              <div class="w-9 h-9 rounded-xl bg-[#00A396]/10 flex items-center justify-center text-[#00A396]">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9"/>
                  <circle cx="12" cy="12" r="4"/>
                  <line x1="12" y1="3" x2="12" y2="7"/>
                  <line x1="12" y1="17" x2="12" y2="21"/>
                  <line x1="3" y1="12" x2="7" y2="12"/>
                  <line x1="17" y1="12" x2="21" y2="12"/>
                </svg>
              </div>
              <span class="font-mono text-xs font-bold tracking-wider px-3 py-1 rounded-full bg-[#00A396]/10 text-[#00A396] border border-[#00A396]/20">
                CAPTURE
              </span>
            </div>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-4">
            시선 유도 자동 촬영 (Gaze Guidance)
          </h3>
          <p class="text-slate-600 text-base leading-relaxed">
            내장된 시선 유도(Gaze Guidance) 인터랙션이 사용자의 동공과 각막 반사점을 실시간으로 자동 정렬하며, 내장 광학 카메라가 고해상도 망막 안저(Fundus) 이미지를 자동 촬영합니다.
          </p>
        </div>

        <!-- Step 3: Screen -->
        <div id="step-card-3" class="chapter-card p-8 sm:p-10 rounded-3xl bg-[#F8FAFC] border border-slate-200 scroll-reveal relative overflow-hidden group">
          <div class="flex items-center justify-between mb-6">
            <span class="font-mono text-3xl font-black text-[#00A396]">03</span>
            <div class="flex items-center gap-3">
              <!-- AI Neural Finding Tag Badge -->
              <div class="w-9 h-9 rounded-xl bg-[#081726] flex items-center justify-center text-[#22D3EE]">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h4v4H4zM16 4h4v4h-4zM4 16h4v4H4zM16 16h4v4h-4z"/>
                  <circle cx="12" cy="12" r="3"/>
                  <path d="M8 6h8M6 8v8M18 8v8M8 18h8"/>
                </svg>
              </div>
              <span class="font-mono text-xs font-bold tracking-wider px-3 py-1 rounded-full bg-[#00A396]/10 text-[#00A396] border border-[#00A396]/20">
                SCREEN
              </span>
            </div>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-4">
            3대 실명 질환 AI 분석 (AI Screening)
          </h3>
          <p class="text-slate-600 text-base leading-relaxed">
            온디바이스 딥러닝 AI가 촬영된 이미지를 즉각 분석하여 <strong>황반변성(AMD), 녹내장(Glaucoma), 당뇨망막병증(DR)</strong>의 초기 징후와 미세 병변을 정밀하게 어노테이션합니다.
          </p>
        </div>

      </div>

    </div>

    <!-- 3 Core Values (Self-operated / Integrated / Continuous) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-16 border-t border-slate-200 scroll-reveal">
      <div class="flex gap-4 items-start">
        <div class="w-10 h-10 rounded-xl bg-[#0F2236] text-white flex items-center justify-center shrink-0 font-bold font-mono text-sm shadow-sm">✓</div>
        <div>
          <h4 class="text-base font-bold text-slate-900 mb-1">Self-operated (완전 자가 측정)</h4>
          <p class="text-xs text-slate-500 leading-relaxed">숙련된 검사 인력이나 전용 임상 시설 없이 누구나 직접 사용 가능합니다.</p>
        </div>
      </div>

      <div class="flex gap-4 items-start">
        <div class="w-10 h-10 rounded-xl bg-[#00A396] text-white flex items-center justify-center shrink-0 font-bold font-mono text-sm shadow-sm">✓</div>
        <div>
          <h4 class="text-base font-bold text-slate-900 mb-1">Integrated (일체형 올인원 디바이스)</h4>
          <p class="text-xs text-slate-500 leading-relaxed">광학 안저 이미지 캡처와 온디바이스 AI 정밀 분석이 단일 헤드셋에서 수행됩니다.</p>
        </div>
      </div>

      <div class="flex gap-4 items-start">
        <div class="w-10 h-10 rounded-xl bg-[#081726] text-white flex items-center justify-center shrink-0 font-bold font-mono text-sm shadow-sm">✓</div>
        <div>
          <h4 class="text-base font-bold text-slate-900 mb-1">Continuous (지속적 재택 모니터링)</h4>
          <p class="text-xs text-slate-500 leading-relaxed">의료 접근성이 취약한 시니어 계층을 위해 정기적이고 연속적인 안건강 관리를 제공합니다.</p>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  // Sticky Step Narrative Tracker
  const stepCards = [
    document.getElementById('step-card-1'),
    document.getElementById('step-card-2'),
    document.getElementById('step-card-3'),
  ];
  const stepNavs = [
    document.getElementById('step-nav-1'),
    document.getElementById('step-nav-2'),
    document.getElementById('step-nav-3'),
  ];

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const index = stepCards.indexOf(entry.target as HTMLElement);
        if (index !== -1) {
          stepCards.forEach((c, i) => {
            if (i === index) c?.classList.add('is-active');
            else c?.classList.remove('is-active');
          });

          stepNavs.forEach((nav, i) => {
            if (i === index) {
              nav?.classList.remove('text-slate-400', 'font-medium');
              nav?.classList.add('text-[#00A396]', 'font-bold');
              const dot = nav?.querySelector('span:first-child');
              if (dot) dot.className = 'w-2 h-2 rounded-full bg-[#00A396]';
            } else {
              nav?.classList.remove('text-[#00A396]', 'font-bold');
              nav?.classList.add('text-slate-400', 'font-medium');
              const dot = nav?.querySelector('span:first-child');
              if (dot) dot.className = 'w-2 h-2 rounded-full bg-slate-300';
            }
          });
        }
      }
    });
  }, { threshold: 0.4, rootMargin: '-10% 0px -10% 0px' });

  stepCards.forEach(card => card && observer.observe(card));
</script>
